---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchitectureDiagram from '../../components/sedic/ArchitectureDiagram.astro';

const tiers = [
  { name: 'Civilian', classes: 'BPSK · QPSK · 16QAM · 64QAM', note: 'Phones, Wi-Fi, data links — must be recognised, not flagged.' },
  { name: 'Military', classes: 'LFM radar · FHSS', note: 'Tactical emissions — judged, must clear 80% recall.' },
  { name: 'Hostile', classes: 'Jamming (barrage · tone · sweep)', note: 'Deliberate interference — judged, must clear 80% recall.' },
  { name: 'Empty', classes: 'Noise floor', note: 'Nothing there — the model must be allowed to say so.' },
];

const sources = [
  { src: 'RadioML 2018.01A', classes: 'BPSK, QPSK, 16QAM, 64QAM', origin: 'Published dataset' },
  { src: 'RadChar', classes: 'LFM radar (part)', origin: 'Published dataset' },
  { src: 'In-house generators', classes: 'LFM radar (rest), FHSS, jamming, noise floor', origin: 'Synthesised by the team' },
  { src: 'Composite overlay', classes: 'A jammer mixed onto any victim signal, at random strength', origin: 'Built from the sources above' },
];

const results = [
  { value: '84.2%', label: 'LFM radar recall', sub: 'judged class · bar is 80%' },
  { value: '82.9%', label: 'FHSS recall', sub: 'judged class · bar is 80%' },
  { value: '84.0%', label: 'Jamming recall', sub: 'judged class · bar is 80%' },
  { value: '99.7%', label: 'Jamming precision', sub: '7 false alarms in 19,260 test windows' },
];

const limits = [
  { t: 'Low SNR is hard', d: 'Recall drops well below the bar at −10 dB. The headline numbers are a test-set average across −10 to +10 dB, not a per-condition guarantee.' },
  { t: 'Synthetic data can fool you', d: 'Nobody gave us FHSS or jamming data, so we generated it. On an independent jamming dataset we never trained on, recall fell to 57.6% — the model had learned some of our generator’s signature.' },
  { t: 'Dense QAM blurs together', d: '16QAM and 64QAM are hard to separate below 0 dB — consistent with the literature, and it does not affect the judged classes.' },
];

const shots = [
  { img: '/images/sedic/console-replay.jpg', title: 'RF Replay', d: 'Spectrogram, per-class detections, and threat tier on one shared time axis. Dashed boxes mark the true answer; analysts can drag to correct the model.' },
  { img: '/images/sedic/console-verdict.jpg', title: 'Verdict', d: 'Grouped detections, worst tier first — e.g. BPSK + QPSK + JAMMING overlapping in one burst.' },
  { img: '/images/sedic/console-signal.jpg', title: 'Signal Analysis', d: 'One 160 µs window exactly as the model sees it, with its attention weights drawn over the measured amplitude.' },
  { img: '/images/sedic/console-assistant.jpg', title: 'Assistant', d: 'Ask “which uploads had jamming?” — it only answers from saved captures and never invents a result.' },
  { img: '/images/sedic/console-report.jpg', title: 'Report builder', d: 'Export captures, human corrections and audit trail as PDF, Excel, CSV, JSON or a SigMF bundle.' },
];
---
<BaseLayout
  theme="sedic"
  title="Project Overwatch — AI radio-signal classifier — Eileen Yeoh"
  description="Team NEXA's SEDIC 2026 RF Track entry: a dual-branch CNN that classifies civilian, military and jamming signals from raw IQ data, including overlapping signals."
>
  <section class="section wrap sedic-hero">
    <p class="eyebrow" data-reveal>Project 04 · 2026 · SEDIC 2026 RF/Signal Track</p>
    <h1 data-split>Project Overwatch</h1>
    <p class="sedic-tagline" data-reveal>
      Teaching a neural network to listen to raw radio — and tell a phone
      call from a radar pulse from a jammer, even when they arrive at once.
    </p>
    <ul class="sedic-tags" data-reveal>
      {['All judged classes > 80% recall', 'PyTorch', 'Dual-branch CNN', 'Multi-label', 'RadioML'].map((t) => <li>{t}</li>)}
    </ul>
  </section>

  <section class="section wrap">
    <p class="eyebrow" data-reveal>The challenge</p>
    <h2 data-split>Eight kinds of signal. Some of them hostile.</h2>
    <p class="muted" data-reveal>
      The brief: build an AI model that classifies radio signals straight from
      raw IQ samples — across clean and noisy conditions — and catch at least
      80% of every military and jamming emission.
    </p>
    <div class="tier-grid">
      {tiers.map((t, i) => (
        <div class="card tier-card" data-reveal data-reveal-delay={i * 0.06}>
          <span class="tier-name">{t.name}</span>
          <h3>{t.classes}</h3>
          <p class="muted">{t.note}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section wrap">
    <p class="eyebrow" data-reveal>The model</p>
    <h2 data-split>Two ways of seeing, one decision.</h2>
    <div class="two-col">
      <p data-reveal>
        Raw IQ keeps phase, which is what civilian modulations are made of. A
        spectrogram makes frequency movement obvious, which is what radar
        chirps and frequency hops are made of. Neither view does both jobs
        well — so both run over the same window and get fused.
      </p>
      <p data-reveal>
        The output is <strong>multi-label</strong>: an independent sigmoid per
        class instead of one winner. That is what lets a single window read as
        “QPSK <em>and</em> jamming” — the situation that matters most in a
        contested spectrum. Five models are averaged as an ensemble, and every
        threshold is calibrated on validation data only.
      </p>
    </div>
    <ArchitectureDiagram />
  </section>

  <section class="section wrap">
    <p class="eyebrow" data-reveal>My part — the data</p>
    <h2 data-split>58,800 windows, four sources, one format.</h2>
    <p class="muted" data-reveal>
      I owned the civilian classes and the data pipeline that assembles the
      training set — loading, windowing, noise injection, normalisation and
      augmentation, all standardised to 512 samples at 3.2 MHz and swept from
      −10 to +10 dB SNR.
    </p>
    <div class="table-wrap" data-reveal>
      <table class="src-table">
        <thead><tr><th>Source</th><th>Classes</th><th>Origin</th></tr></thead>
        <tbody>
          {sources.map((s) => (
            <tr><td>{s.src}</td><td>{s.classes}</td><td class="muted">{s.origin}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="card catch" data-reveal>
      <h3>🐛 The bug most teams won't have caught</h3>
      <p class="muted">
        RadioML 2018's shipped class-index file doesn't match the data it
        describes. I caught the mismatch while building the loader and fixed
        the mapping, so our civilian labels are right — a silent mislabelling
        here would have poisoned every downstream number.
      </p>
    </div>
  </section>

  <section class="section wrap outcome">
    <p class="eyebrow" data-reveal>Results</p>
    <h2 data-split>Every judged class clears the bar.</h2>
    <div class="roi-grid">
      {results.map((r, i) => (
        <div class="roi-card" data-reveal data-reveal-delay={i * 0.06}>
          <span class="roi-value">{r.value}</span>
          <span class="roi-label">{r.label}</span>
          <span class="roi-sub muted">{r.sub}</span>
        </div>
      ))}
    </div>
    <p class="muted outcome-note" data-reveal>
      5-model ensemble on a held-out test split of 19,260 windows. All five
      unjudged classes also clear 80% recall. Radar and FHSS deliberately
      trade precision for recall — against this benchmark, a missed emission
      costs more than a false alarm.
    </p>
  </section>

  <section class="section wrap">
    <p class="eyebrow" data-reveal>Honest limits</p>
    <h2 data-split>What we found before anyone else could.</h2>
    <div class="gov-grid">
      {limits.map((l, i) => (
        <div class="card" data-reveal data-reveal-delay={i * 0.08}>
          <h3>{l.t}</h3>
          <p class="muted">{l.d}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section wrap">
    <p class="eyebrow" data-reveal>The OMNI console</p>
    <h2 data-split>A model is only useful if someone can trust it.</h2>
    <p class="muted" data-reveal>
      We wrapped the classifier in a web console for an analyst: replay a
      capture, see why the model decided what it did, correct it, and export
      the evidence.
    </p>
    <div class="shot-list">
      {shots.map((s, i) => (
        <figure class:list={['shot', { 'shot--wide': i === 0 }]} data-reveal>
          <img src={s.img} alt={`OMNI console — ${s.title}`} loading="lazy" />
          <figcaption><strong>{s.title}.</strong> <span class="muted">{s.d}</span></figcaption>
        </figure>
      ))}
    </div>
    <p class="muted outcome-note" data-reveal>
      Built with Eavan Tan, Jessy Pang, and Chua Xin Ying as team NEXA — each
      of us owned one signal category end to end, plus one shared part of the
      pipeline.
    </p>
    <a class="btn" href="https://github.com/eavan127/sedicAI_NEXA" target="_blank" rel="noopener" data-reveal>
      View the source on GitHub →
    </a>
  </section>
</BaseLayout>

<style>
  .sedic-hero h1 { font-size: clamp(3rem, 10vw, 7rem); }
  .sedic-tagline { font-size: 1.3rem; max-width: 44ch; margin-top: 1.2rem; }
  .sedic-tags { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.8rem; }
  .sedic-tags li {
    font-size: 0.8rem;
    font-weight: 550;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--paper-raised);
  }
  .sedic-tags li:first-child { background: var(--accent-soft); border-color: transparent; color: var(--accent); font-weight: 650; }
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; margin-top: 2rem; }
  .tier-grid, .gov-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1.2rem;
    margin-top: 2.5rem;
  }
  .tier-name { display: inline-block; font-size: 0.78rem; font-weight: 650; color: var(--accent); text-transform: uppercase; letter-spacing: 0.05em; }
  .tier-card h3 { margin-top: 0.35rem; font-size: 1rem; }
  .tier-card p, .gov-grid p { font-size: 0.9rem; margin-top: 0.4rem; }
  .table-wrap { overflow-x: auto; margin-top: 2rem; }
  .src-table { width: 100%; border-collapse: collapse; background: var(--paper-raised); border: 1px solid var(--line); border-radius: var(--radius); font-size: 0.92rem; }
  .src-table th, .src-table td { text-align: left; padding: 0.85rem 1rem; border-bottom: 1px solid var(--line); vertical-align: top; }
  .src-table th { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--accent); }
  .src-table tr:last-child td { border-bottom: none; }
  .catch { margin-top: 1.5rem; background: var(--accent-soft); border-color: transparent; }
  .catch p { font-size: 0.92rem; margin-top: 0.4rem; }
  .roi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
    margin-top: 2.5rem;
  }
  .roi-card {
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .roi-value { font-family: var(--font-display); font-size: 2.2rem; color: var(--accent); }
  .roi-label { font-weight: 600; }
  .roi-sub { font-size: 0.82rem; }
  .outcome-note { margin-top: 2.5rem; max-width: 62ch; }
  .shot-list { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-top: 2.5rem; align-items: start; }
  .shot { margin: 0; background: var(--paper-raised); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .shot--wide { grid-column: 1 / -1; }
  .shot img { display: block; width: 100%; height: auto; border-bottom: 1px solid var(--line); }
  .shot figcaption { padding: 0.9rem 1.1rem; font-size: 0.88rem; }
  section > .btn { margin-top: 1.5rem; }
  @media (max-width: 800px) {
    .two-col, .shot-list { grid-template-columns: 1fr; }
  }
</style>
