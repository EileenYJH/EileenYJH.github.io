---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectHero from '../../components/project/ProjectHero.astro';
import ArchitectureDiagram from '../../components/sedic/ArchitectureDiagram.astro';
import '@fontsource-variable/montserrat';

const tiers = [
  { tone: 'civ', name: 'Civilian', classes: 'BPSK · QPSK · 16QAM · 64QAM', note: 'Phones, Wi-Fi, data links: must be recognised, not flagged.' },
  { tone: 'mil', name: 'Military', classes: 'LFM radar · FHSS', note: 'Tactical emissions: judged, must clear 80% recall.' },
  { tone: 'hos', name: 'Hostile', classes: 'Jamming (barrage · tone · sweep)', note: 'Deliberate interference: judged, must clear 80% recall.' },
  { tone: 'emp', name: 'Empty', classes: 'Noise floor', note: 'Nothing there, and the model must be allowed to say so.' },
];

const sources = [
  { src: 'RadioML 2018.01A', classes: 'BPSK, QPSK, 16QAM, 64QAM', origin: 'Published dataset' },
  { src: 'RadChar', classes: 'LFM radar (part)', origin: 'Published dataset' },
  { src: 'In-house generators', classes: 'LFM radar (rest), FHSS, jamming, noise floor', origin: 'Synthesised by the team' },
  { src: 'Composite overlay', classes: 'A jammer mixed onto any victim signal, at random strength', origin: 'Built from the sources above' },
];

const results = [
  { tone: 'mil', value: '84.2%', label: 'LFM radar recall', sub: 'judged class · bar is 80%' },
  { tone: 'mil', value: '82.9%', label: 'FHSS recall', sub: 'judged class · bar is 80%' },
  { tone: 'hos', value: '84.0%', label: 'Jamming recall', sub: 'judged class · bar is 80%' },
  { tone: 'solid', value: '99.7%', label: 'Jamming precision', sub: '7 false alarms in 19,260 test windows' },
];

const limits = [
  { t: 'Low SNR is hard', d: 'Recall drops well below the bar at −10 dB. The headline numbers are a test-set average across −10 to +10 dB, not a per-condition guarantee.' },
  { t: 'Synthetic data can fool you', d: 'Nobody gave us FHSS or jamming data, so we generated it. On an independent jamming dataset we never trained on, recall fell to 57.6%. The model had learned some of our generator’s signature.' },
  { t: 'Dense QAM blurs together', d: '16QAM and 64QAM are hard to separate below 0 dB, consistent with the literature, and it does not affect the judged classes.' },
];

const shots = [
  { img: '/images/sedic/console-replay.jpg', title: 'RF Replay', d: 'Spectrogram, per-class detections, and threat tier on one shared time axis. Dashed boxes mark the true answer; analysts can drag to correct the model.' },
  { img: '/images/sedic/console-verdict.jpg', title: 'Verdict', d: 'Grouped detections, worst tier first, e.g. BPSK + QPSK + JAMMING overlapping in one burst.' },
  { img: '/images/sedic/console-signal.jpg', title: 'Signal Analysis', d: 'One 160 µs window exactly as the model sees it, with its attention weights drawn over the measured amplitude.' },
  { img: '/images/sedic/console-assistant.jpg', title: 'Assistant', d: 'Ask “which uploads had jamming?” It only answers from saved captures and never invents a result.' },
  { img: '/images/sedic/console-report.jpg', title: 'Report builder', d: 'Export captures, human corrections and audit trail as PDF, Excel, CSV, JSON or a SigMF bundle.' },
];

// Photos from the SEDIC 2026 finale (from Eileen's portfolio Drive folder).
const dayPhotos = [
  { src: '/images/sedic/event/prize-ceremony.jpg', shape: 'wide', alt: 'Prize presentation for Track Project Overwatch at SEDIC 2026', cap: 'Prize presentation for Track 1: Project Overwatch.' },
  { src: '/images/sedic/event/grand-finale.jpg', shape: 'tall', alt: 'Team NEXA with the NEXA banner at the SEDIC 26 grand finale pitching', cap: 'Grand finale pitching.' },
  { src: '/images/sedic/event/with-judge.jpg', shape: 'wide', alt: 'Team NEXA with a guest in uniform at the SEDIC 2026 exhibition', cap: 'Team NEXA at the SEDIC 2026 exhibition.' },
  { src: '/images/sedic/event/cyberdsa.jpg', shape: 'tall', alt: 'Team NEXA in front of the CyberDSA 2026 sign with the Track Winner cheque', cap: 'At CyberDSA 2026, MITEC.' },
];

const posters = [
  { src: '/sedic/materials/nexa-poster-1.html', title: 'Poster 1: A dual-branch fusion CNN for multi-label RF signal classification' },
  { src: '/sedic/materials/nexa-poster-2.html', title: 'Poster 2: Inside NEXA, the system architecture' },
];
---
<BaseLayout
  overlayNav
  theme="sedic"
  title="Project Overwatch: AI radio-signal classifier | Eileen Yeoh"
  description="Team NEXA's track-winning SEDIC 2026 entry for Project Overwatch (Track 1): a dual-branch CNN that classifies civilian, military and jamming signals from raw IQ data, including overlapping signals."
>
  <ProjectHero img="/images/projects-hero/sedic.jpg" alt="Team NEXA holding the Track Winner cheque on the SEDIC 2026 stage" caption="Team NEXA, Track Winner of Project Overwatch at the SEDIC 2026 closing ceremony, MITEC, 7 Oct 2026." focus="50% 70%" event="#22D3EE">
    <p class="eyebrow" data-reveal>Project 04 · 2026 · SEDIC 2026 · Track 1</p>
    <h1 data-split>Project Overwatch</h1>
    <p class="sedic-tagline" data-reveal>
      Teaching a neural network to listen to raw radio and tell a phone
      call from a radar pulse from a jammer, even when they arrive at once.
    </p>
    <ul class="sedic-tags" data-reveal>
      {['🏆 Track Winner, Track 1', 'All judged classes > 80% recall', 'PyTorch', 'Dual-branch CNN', 'Multi-label', 'RadioML'].map((t) => <li>{t}</li>)}
    </ul>
  </ProjectHero>

  <section class="section wrap sedic-day">
    <p class="eyebrow" data-reveal>More from the day</p>
    <div class="day-grid">
      {dayPhotos.map((d, i) => (
        <figure class:list={['day-photo', `day-photo--${d.shape}`]} data-reveal data-reveal-delay={i * 0.05}>
          <img src={d.src} alt={d.alt} loading="lazy" decoding="async" />
          <figcaption>{d.cap}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="section wrap sedic-mat" id="materials">
    <p class="eyebrow" data-reveal>What we presented</p>
    <h2 data-split>Poster, brochure, video and report.</h2>

    <div class="mat-block">
      <div class="mat-head"><h3>Finale posters</h3><span class="muted">Shown on the TV screens at our booth. They're live, so they animate here too.</span></div>
      <div class="poster-grid">
        {posters.map((pt) => (
          <figure class="poster">
            <div class="poster-frame" data-poster>
              <iframe src={pt.src} title={pt.title} loading="lazy" tabindex="-1"></iframe>
            </div>
            <figcaption><strong>{pt.title}</strong> <a href={pt.src} target="_blank" rel="noopener">Open full screen ↗</a></figcaption>
          </figure>
        ))}
      </div>
    </div>

    <div class="mat-block">
      <div class="mat-head"><h3>eBrochure</h3><span class="muted">Eight pages. Scroll sideways to flip through.</span><a class="btn mat-btn" href="/sedic/materials/NEXA-eBrochure.pdf" target="_blank" rel="noopener">Open the PDF ↗</a></div>
      <div class="brochure">
        {Array.from({ length: 8 }, (_, i) => (
          <a class="bro-page" href="/sedic/materials/NEXA-eBrochure.pdf" target="_blank" rel="noopener">
            <img src={`/sedic/materials/brochure-${i + 1}.jpg`} alt={`NEXA eBrochure page ${i + 1}`} loading="lazy" decoding="async" />
            <span>{i + 1}</span>
          </a>
        ))}
      </div>
    </div>

    <div class="mat-two">
      <div class="mat-block">
        <div class="mat-head"><h3>Demo video</h3><span class="muted">Our submission video.</span><a class="mat-link" href="https://www.youtube.com/watch?v=11AyQioekdo" target="_blank" rel="noopener">Watch on YouTube ↗</a></div>
        <div class="video-frame">
          <iframe src="https://www.youtube-nocookie.com/embed/11AyQioekdo?rel=0" title="NEXA SEDIC 2026 demo video" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
        </div>
      </div>
      <a class="mat-block report-card" href="https://docs.google.com/document/d/1Sin00wQhauDyScpZ8gFa7-64XwEvTTql7f9Fw3NbgE8/preview" target="_blank" rel="noopener">
        <span class="report-kicker">Technical report</span>
        <strong>NEXA: SEDIC 2026 report</strong>
        <span class="muted">Our full technical write-up for SEDIC 2026.</span>
        <span class="report-go">Read the report ↗</span>
      </a>
    </div>
  </section>

  <div class="nexa-skin">
  <section class="section wrap">
    <p class="eyebrow" data-reveal>The challenge</p>
    <h2 data-split>Eight kinds of signal. Some of them hostile.</h2>
    <p class="muted" data-reveal>
      The brief: build an AI model that classifies radio signals straight from
      raw IQ samples, across clean and noisy conditions, and catch at least
      80% of every military and jamming emission.
    </p>
    <div class="tier-grid">
      {tiers.map((t, i) => (
        <div class:list={['card tier-card', `tone-${t.tone}`]} data-reveal data-reveal-delay={i * 0.06}>
          <span class="tier-name">{t.name}</span>
          <h3>{t.classes}</h3>
          <p class="muted">{t.note}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section wrap">
    <p class="eyebrow" data-reveal>The model</p>
    <h2 data-split>Two ways of seeing, one decision.</h2>
    <div class="two-col">
      <p data-reveal>
        Raw IQ keeps phase, which is what civilian modulations are made of. A
        spectrogram makes frequency movement obvious, which is what radar
        chirps and frequency hops are made of. Neither view does both jobs
        well, so both run over the same window and get fused.
      </p>
      <p data-reveal>
        The output is <strong>multi-label</strong>: an independent sigmoid per
        class instead of one winner. That is what lets a single window read as
        “QPSK <em>and</em> jamming”, the situation that matters most in a
        contested spectrum. Five models are averaged as an ensemble, and every
        threshold is calibrated on validation data only.
      </p>
    </div>
    <ArchitectureDiagram />
  </section>

  <section class="section wrap">
    <p class="eyebrow" data-reveal>My part: the data</p>
    <h2 data-split>58,800 windows, four sources, one format.</h2>
    <p class="muted" data-reveal>
      I owned the civilian classes and the data pipeline that assembles the
      training set: loading, windowing, noise injection, normalisation and
      augmentation, all standardised to 512 samples at 3.2 MHz and swept from
      −10 to +10 dB SNR.
    </p>
    <div class="table-wrap" data-reveal>
      <table class="src-table">
        <thead><tr><th>Source</th><th>Classes</th><th>Origin</th></tr></thead>
        <tbody>
          {sources.map((s) => (
            <tr><td>{s.src}</td><td>{s.classes}</td><td class="muted">{s.origin}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="card catch" data-reveal>
      <h3>🐛 The bug most teams won't have caught</h3>
      <p class="muted">
        RadioML 2018's shipped class-index file doesn't match the data it
        describes. I caught the mismatch while building the loader and fixed
        the mapping, so our civilian labels are right. A silent mislabelling
        here would have poisoned every downstream number.
      </p>
    </div>
  </section>

  <section class="section wrap outcome">
    <p class="eyebrow" data-reveal>Results</p>
    <h2 data-split>Every judged class clears the bar.</h2>
    <div class="roi-grid">
      {results.map((r, i) => (
        <div class:list={['roi-card', `tone-${r.tone}`]} data-reveal data-reveal-delay={i * 0.06}>
          <span class="roi-value">{r.value}</span>
          <span class="roi-label">{r.label}</span>
          <span class="roi-sub muted">{r.sub}</span>
        </div>
      ))}
    </div>
    <p class="muted outcome-note" data-reveal>
      5-model ensemble on a held-out test split of 19,260 windows. All five
      unjudged classes also clear 80% recall. Radar and FHSS deliberately
      trade precision for recall. Against this benchmark, a missed emission
      costs more than a false alarm.
    </p>
  </section>

  <section class="section wrap">
    <p class="eyebrow" data-reveal>Honest limits</p>
    <h2 data-split>What we found before anyone else could.</h2>
    <div class="gov-grid">
      {limits.map((l, i) => (
        <div class="card" data-reveal data-reveal-delay={i * 0.08}>
          <h3>{l.t}</h3>
          <p class="muted">{l.d}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section wrap">
    <p class="eyebrow" data-reveal>The OMNI console</p>
    <h2 data-split>A model is only useful if someone can trust it.</h2>
    <p class="muted" data-reveal>
      We wrapped the classifier in a web console for an analyst: replay a
      capture, see why the model decided what it did, correct it, and export
      the evidence.
    </p>
    <div class="shot-list">
      {shots.map((s, i) => (
        <figure class:list={['shot', { 'shot--wide': i === 0 }]} data-reveal>
          <img src={s.img} alt={`OMNI console: ${s.title}`} loading="lazy" />
          <figcaption><strong>{s.title}.</strong> <span class="muted">{s.d}</span></figcaption>
        </figure>
      ))}
    </div>
    <p class="muted outcome-note" data-reveal>
      Built with Eavan Tan, Jessy Pang, and Chua Xin Ying as team NEXA, Track Winner of
      Project Overwatch (Track 1) at SEDIC 2026, with our advisor Ts Dr Noureen Talpur. Each
      of us owned one signal category end to end, plus one shared part of the
      pipeline.
    </p>
    <a class="btn" href="https://github.com/eavan127/sedicAI_NEXA" target="_blank" rel="noopener" data-reveal>
      View the source on GitHub →
    </a>
  </section>
  </div>
  <script>
    // The posters are built for a 1920 × 1080 screen; scale each to fit its frame.
    const frames = document.querySelectorAll<HTMLElement>('[data-poster]');
    const fit = () => frames.forEach((f) => f.style.setProperty('--s', String(f.clientWidth / 1920)));
    new ResizeObserver(fit).observe(document.body);
    fit();
  </script>
</BaseLayout>

<style>
  /* Technical write-up in the NEXA poster and brochure palette. */
  .nexa-skin {
    --nx-navy: #22306B; --nx-blue: #2E7DB9; --nx-orange: #F0A020; --nx-amber: #C77A00;
    --nx-red: #B0281A; --nx-green: #457900; --nx-slate: #0E1622; --nx-pill: #F1F1F1;
    --accent: var(--nx-navy); --accent-rgb: 34, 48, 107; --accent-soft: #E6EFF7;
    background:
      radial-gradient(900px 400px at 100% 0%, rgba(46, 125, 185, 0.07), transparent 70%),
      radial-gradient(700px 360px at 0% 40%, rgba(240, 160, 32, 0.06), transparent 70%);
    border-top: 6px solid transparent;
    border-image: linear-gradient(90deg, var(--nx-blue), var(--nx-orange), var(--nx-red), var(--nx-green)) 1;
  }
  .nexa-skin :global(h2), .nexa-skin :global(h3), .nexa-skin .roi-value, .nexa-skin .tier-name {
    font-family: 'Montserrat Variable', var(--font-display);
  }
  .nexa-skin :global(h2) { color: var(--nx-navy); font-weight: 800; letter-spacing: -0.02em; }
  .nexa-skin .eyebrow {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.35rem 1rem; border-radius: 999px;
    background: var(--nx-pill); color: var(--nx-navy);
    font-family: 'Montserrat Variable', sans-serif; font-weight: 800; font-size: 0.78rem;
    letter-spacing: 0.14em; text-transform: uppercase;
  }
  .nexa-skin .eyebrow::before { background: var(--nx-red); box-shadow: 0 0 0 3px rgba(176, 40, 26, 0.18); }
  .nexa-skin .tier-card { border-top: 4px solid var(--tk); }
  .nexa-skin .tier-name { color: var(--tk); background: var(--tt); padding: 0.2rem 0.65rem; border-radius: 999px; font-weight: 800; letter-spacing: 0.1em; }
  .tone-civ { --tk: #1F5F91; --tt: #E6EFF7; }
  .tone-mil { --tk: #8A5600; --tt: #FDF1DD; }
  .tone-hos { --tk: #8E1F14; --tt: #F6E4E2; }
  .tone-emp { --tk: #365F00; --tt: #E9F0DF; }
  .nexa-skin .roi-card { border: 2px solid var(--tk, var(--line)); background: var(--tt, var(--paper-raised)); }
  .nexa-skin .roi-card .roi-value { color: var(--tk); font-weight: 800; }
  .nexa-skin .roi-card.tone-solid { background: var(--nx-red); border-color: var(--nx-red); color: #fff; }
  .nexa-skin .roi-card.tone-solid .roi-value, .nexa-skin .roi-card.tone-solid .roi-label { color: #fff; }
  .nexa-skin .roi-card.tone-solid .roi-sub { color: rgba(255, 255, 255, 0.85); }
  .nexa-skin .src-table { border-color: #E3E3E3; }
  .nexa-skin .src-table th { background: var(--nx-navy); color: #fff; }
  .nexa-skin .src-table tr:nth-child(even) td { background: #FAFAFA; }
  .nexa-skin .catch { background: #E6EFF7; border-left: 5px solid var(--nx-blue); }
  .nexa-skin .gov-grid :global(.card) { border-left: 5px solid var(--nx-orange); }
  .nexa-skin .gov-grid :global(.card:nth-child(2)) { border-left-color: var(--nx-red); }
  .nexa-skin .gov-grid :global(.card:nth-child(3)) { border-left-color: var(--nx-blue); }
  .nexa-skin :global(.arch-branch) { border: 2px solid var(--nx-blue); }
  .nexa-skin :global(.arch-branch:nth-child(2)) { border-color: var(--nx-orange); }
  .nexa-skin :global(.arch-branch .arch-label) { color: var(--nx-blue); }
  .nexa-skin :global(.arch-branch:nth-child(2) .arch-label) { color: var(--nx-amber); }
  .nexa-skin :global(.arch-step) { border-top: 3px solid var(--nx-green); }
  .nexa-skin :global(.arch-out) { background: #F6E4E2; border-left: 5px solid var(--nx-red); }
  .nexa-skin :global(.arch-out code) { color: var(--nx-red); }
  .nexa-skin .shot { border-color: #E3E3E3; }
  .nexa-skin .shot figcaption strong { color: var(--nx-navy); }
  .nexa-skin > section:last-child { background: var(--nx-slate); color: #E8ECF2; margin-top: var(--space-section); max-width: none; width: 100%; padding-inline: max(1.5rem, calc((100% - var(--content-w)) / 2)); }
  .nexa-skin > section:last-child :global(h2) { color: #fff; }
  .nexa-skin > section:last-child .eyebrow { background: rgba(255, 255, 255, 0.1); color: #fff; }
  .nexa-skin > section:last-child .muted, .nexa-skin > section:last-child :global(.muted) { color: rgba(232, 236, 242, 0.75); }
  .nexa-skin > section:last-child .shot { background: #16202F; border-color: rgba(255, 255, 255, 0.12); }
  .nexa-skin > section:last-child .shot figcaption strong { color: var(--nx-orange); }
  .nexa-skin > section:last-child .btn { background: var(--nx-orange); color: #151A2E; border-color: var(--nx-orange); }

  .sedic-mat h2 { margin-bottom: 0.5rem; }
  .mat-block { margin-top: 2.4rem; }
  .mat-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.4rem 1rem; margin-bottom: 1rem; }
  .mat-head h3 { font-size: 1.3rem; }
  .mat-head .muted { font-size: 0.92rem; }
  .mat-btn { margin-left: auto; }
  .mat-link { margin-left: auto; font-size: 0.9rem; font-weight: 600; color: var(--accent); text-decoration: none; }
  .poster-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr)); gap: 1.2rem; }
  .poster { margin: 0; }
  .poster-frame { position: relative; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 14px; border: 1px solid var(--line); background: #fff; box-shadow: 0 24px 50px -32px rgba(21, 26, 46, 0.5); }
  .poster-frame iframe { position: absolute; top: 0; left: 0; width: 1920px; height: 1080px; border: 0; transform: scale(var(--s, 0.3)); transform-origin: 0 0; pointer-events: none; }
  .poster figcaption { margin-top: 0.6rem; font-size: 0.9rem; color: var(--muted); display: flex; flex-wrap: wrap; gap: 0.3rem 0.8rem; }
  .poster figcaption strong { color: var(--ink); font-weight: 600; }
  .poster figcaption a { color: var(--accent); font-weight: 600; text-decoration: none; }
  .brochure { display: flex; gap: 1rem; overflow-x: auto; scroll-snap-type: x mandatory; padding: 0.3rem 0.2rem 1rem; }
  .bro-page { position: relative; flex: 0 0 auto; width: min(260px, 62vw); scroll-snap-align: start; border-radius: 10px; overflow: hidden; border: 1px solid var(--line); box-shadow: 0 16px 34px -24px rgba(21, 26, 46, 0.55); transition: transform 0.3s ease; }
  .bro-page:hover { transform: translateY(-4px) rotate(-0.6deg); }
  .bro-page img { width: 100%; height: auto; display: block; }
  .bro-page span { position: absolute; left: 0.5rem; bottom: 0.5rem; font-size: 0.75rem; font-weight: 700; color: #fff; background: var(--accent); border-radius: 999px; padding: 0.1rem 0.5rem; }
  .mat-two { display: grid; grid-template-columns: 1.6fr 1fr; gap: 1.4rem; align-items: start; }
  .video-frame { aspect-ratio: 16 / 9; border-radius: 14px; overflow: hidden; background: #0B0F1C; }
  .video-frame iframe { width: 100%; height: 100%; border: 0; }
  .report-card { display: grid; gap: 0.5rem; align-content: start; margin-top: calc(2.4rem + 2.6rem); padding: 1.4rem; border-radius: 14px; text-decoration: none; color: #fff; background: linear-gradient(150deg, var(--accent), #22D3EE); box-shadow: 0 24px 50px -30px rgba(var(--accent-rgb), 0.8); transition: transform 0.3s ease; }
  .report-card:hover { transform: translateY(-4px); }
  .report-card strong { font-size: 1.3rem; line-height: 1.2; }
  .report-card .muted { color: rgba(255, 255, 255, 0.85); font-size: 0.92rem; }
  .report-kicker { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; opacity: 0.9; }
  .report-go { font-weight: 650; margin-top: 0.4rem; }
  @media (max-width: 800px) { .mat-two { grid-template-columns: 1fr; } .report-card { margin-top: 1.4rem; } .mat-btn { margin-left: 0; } }

  .sedic-hero h1 { font-size: clamp(3rem, 10vw, 7rem); }
  .sedic-tagline { font-size: 1.3rem; max-width: 44ch; margin-top: 1.2rem; }
  .sedic-tags { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.8rem; }
  .sedic-tags li {
    font-size: 0.8rem;
    font-weight: 550;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--paper-raised);
  }
  .sedic-tags li:first-child { background: var(--accent-soft); border-color: transparent; color: var(--accent); font-weight: 650; }
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; margin-top: 2rem; }
  .tier-grid, .gov-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1.2rem;
