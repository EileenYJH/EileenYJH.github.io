---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectHero from '../../components/project/ProjectHero.astro';
import PipelineDiagram from '../../components/nexa/PipelineDiagram.astro';
import VideoCard from '../../components/nexa/VideoCard.astro';

const demos = [
  { title: 'AI Chatbot', description: 'Ask the assistant a question about a shipment. It routes by topic, cites every number, and remembers the conversation.', poster: '/images/nexa/poster-ai-chatbot.jpg', src: '/videos/nexa/demo-ai-chatbot.mp4' },
  { title: 'Parallel Processing', description: 'Five threads classify, match, and cost multiple shipments concurrently instead of one at a time.', poster: '/images/nexa/poster-parallel-processing.jpg', src: '/videos/nexa/demo-parallel-processing.mp4' },
  { title: 'Dashboard & Analytics', description: 'Live batch progress, AI confidence distribution, and FTA savings: the analyst’s home screen.', poster: '/images/nexa/poster-dashboard-analytics.png', src: '/videos/nexa/demo-dashboard-analytics.mp4' },
  { title: 'Shipment Filter & Lookup', description: 'Search and filter across all shipments by HS code, confidence, or status.', poster: '/images/nexa/poster-shipment-filter.jpg', src: '/videos/nexa/demo-shipment-filter.mp4' },
  { title: 'Validation Workflow', description: 'Three confidence tiers, three review depths, from one-click bulk approval to full manual escalation.', poster: '/images/nexa/poster-validation-cases.jpg', src: '/videos/nexa/demo-validation-cases.mp4' },
  { title: 'Audit Trail', description: 'Every AI step and human decision, logged immutably: the documentary proof an Excel sheet can never provide.', poster: '/images/nexa/poster-audit-trail.jpg', src: '/videos/nexa/demo-audit-trail.mp4' },
];

const tiers = [
  { range: '>95%', name: 'Scan & Approve', action: 'Reviews the summary line. Can bulk-approve all green items in one click.' },
  { range: '70 to 94%', name: 'Individual Review', action: 'Opens the reasoning log, reviews HS chapter notes, approves or overrides with a documented reason.' },
  { range: '<70% or alert', name: 'Full Manual', action: 'Senior analyst reviews with full context and can override, request supplier clarification, or hold the shipment.' },
];

const roi = [
  { value: '98%', label: 'reduction in processing time', sub: '12.5 hrs → ~15 min analyst review per batch' },
  { value: 'RM 64K', label: 'net monthly savings', sub: 'RM 83K saved − RM 18K operating cost' },
  { value: '85 to 90%', label: 'AI classification accuracy', sub: 'at 10-digit HTS, hybrid human + AI' },
  { value: 'Month 8', label: 'breakeven, base case', sub: '5-year NPV positive from Year 1' },
];
---
<BaseLayout
  overlayNav
  theme="nexa"
  title="NEXA: AI-powered tariff automation | Eileen Yeoh"
  description="A hybrid AI + human-validated system that classifies HS tariff codes, matches FTAs, and calculates landed cost for Jabil's trade compliance team. Champion, Jabil IT ECP Bootcamp 3.0."
>
  <ProjectHero img="/images/projects-hero/jabil.jpg" alt="Team NEXA at the Jabil IT ECP Bootcamp 3.0 final" caption="Team NEXA at the Jabil IT ECP Bootcamp 3.0: Data & AI Innovation final, where we were named Champion." post="https://www.linkedin.com/feed/update/urn:li:activity:7478788671337410560/" event="#2478CC">
    <p class="eyebrow" data-reveal>Project 02 · 2026 · Jabil IT ECP Bootcamp 3.0</p>
    <h1 data-split>NEXA</h1>
    <p class="nexa-tagline" data-reveal>
      An AI-assisted, human-validated bridge between SAP and global trade
      compliance, turning a 12.5-hour manual batch into a 15-minute review.
    </p>
    <ul class="nexa-tags" data-reveal>
      {['🏆 Champion, Use Case 2', 'LangChain', 'Azure OpenAI', 'SAP S/4HANA', 'e2open GTM'].map((t) => <li>{t}</li>)}
    </ul>
  </ProjectHero>

  <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />

  <div class="nexa-skin">

  <section class="nx-cover" id="slides">
    <div class="nx-blob" aria-hidden="true"></div>
    <div class="wrap">
      <p class="nx-kicker" data-reveal>How can we<br /><strong>Tango with AI?</strong></p>
      <h2 class="nx-title" data-reveal><span class="nx-shadow">NEXA's</span> AI-Assisted Tariff Calculation Automation</h2>
      <p class="nx-lede" data-reveal>The proposal deck we pitched at the final, 24 June 2026. Use the arrows to flip through all 27 slides.</p>
      <figure class="nx-slides" data-reveal>
        <div class="nx-frame">
          <iframe src="https://www.canva.com/design/DAHJpr88qDg/EEv1KjpHxZe6B-jVqjwT7w/view?embed" title="NEXA presentation slides for Jabil Use Case 2" allow="fullscreen" allowfullscreen loading="lazy"></iframe>
        </div>
        <figcaption>
          <span>Presented by <strong>Eileen Yeoh Jing Han, Eavan Tan, Jessy Pang Xin Yuan, Chua Xin Ying</strong></span>
          <a href="https://www.canva.com/design/DAHJpr88qDg/EEv1KjpHxZe6B-jVqjwT7w/view" target="_blank" rel="noopener">Open in Canva ↗</a>
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section wrap">
    <p class="nx-eyebrow" data-reveal>Root cause analysis</p>
    <h2 data-split>The bottleneck of <span class="hl-red">manual</span> calculation.</h2>
    <div class="nx-kpis">
      <div class="nx-kpi" style="--bar:#fc6c18" data-reveal>
        <span class="nx-kpi-val" style="color:#e85d0c">12.5 hrs</span>
        <span class="nx-kpi-label">Manual hours per 50 item batch workflow</span>
      </div>
      <div class="nx-kpi nx-kpi--filled" data-reveal data-reveal-delay="0.06">
        <span class="nx-kpi-val">≥$500,000</span>
        <span class="nx-kpi-label">Error exposure a year</span>
        <span class="nx-kpi-note">about $2,500 per batch, 500 SKUs each</span>
      </div>
      <div class="nx-kpi" style="--bar:#1884cc" data-reveal data-reveal-delay="0.12">
        <span class="nx-kpi-val" style="color:#1468b8">100K</span>
        <span class="nx-kpi-label">SKUs classified every year</span>
      </div>
      <div class="nx-kpi" style="--bar:#f09c00" data-reveal data-reveal-delay="0.18">
        <span class="nx-kpi-val" style="color:#e85d0c">SLOW</span>
        <span class="nx-kpi-label">Response to regulatory changes. No live regulatory feed</span>
      </div>
    </div>
    <div class="problem-grid">
      <p data-reveal>
        Jabil's trade compliance analysts classify HS codes, match free trade
        agreements, and calculate landed cost by hand. It is an 8 step process,
        and at around 100,000 SKUs a year that is a structural bottleneck, not a
        one off delay.
      </p>
      <p data-reveal>
        SAP and e2open already hold the data, but it stays <strong>fragmented</strong> across
        platforms, earlier automation lacked <strong>explainability</strong>, and there was no
        <strong>governance</strong> framework to make AI a safe option, until now.
      </p>
    </div>
  </section>

  <section class="section nx-band">
    <div class="wrap">
      <p class="nx-eyebrow" data-reveal>The system</p>
      <h2 data-split>One pipeline. <span class="hl-blue">Mandatory</span> human sign-off.</h2>
      <p class="muted" data-reveal>
        NEXA sits as an intelligent bridge layer between SAP S/4HANA, SAP GTS,
        the regulatory feed, and e2open GTM. It classifies, matches, and costs
        every shipment, then stops for a human before anything is written
        back.
      </p>
      <div class="nx-panel" data-reveal>
        <div class="nx-panel-head">
          <span class="nx-panel-title">AI pipeline</span>
          <span class="nx-live"><i></i>Live · Supabase</span>
        </div>
        <div class="nx-panel-body"><PipelineDiagram /></div>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <p class="nx-eyebrow" data-reveal>Demo video</p>
    <h2 data-split>Six views into the <span class="hl-blue">system</span>.</h2>
    <p class="muted" data-reveal>
      Captured from the live prototype. Click any card to play.
    </p>
    <div class="demo-grid">
      {demos.map((d) => <VideoCard title={d.title} description={d.description} poster={d.poster} src={d.src} />)}
    </div>
  </section>

  <section class="section nx-band">
    <div class="wrap">
      <p class="nx-eyebrow" data-reveal>Human in the loop</p>
      <h2 data-split><span class="hl-blue">AI</span> handles the volume. <span class="hl-orange">Humans</span> handle the complexity.</h2>
      <p class="muted" data-reveal>
        Every classification carries a confidence score, and the score decides
        how much scrutiny it gets before touching SAP.
      </p>
      <div class="tier-grid">
        {tiers.map((t, i) => (
          <div class="nx-tier" style={`--bar:${['#1884cc', '#305478', '#e43c3c'][i]};--lab:${['#0e7c86', '#0e7c86', '#e43c3c'][i]}`} data-reveal data-reveal-delay={i * 0.08}>
            <span class="nx-tier-label">Confidence {t.range}</span>
            <h3>{t.name}</h3>
            <p>{t.action}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section wrap">
    <p class="nx-eyebrow" data-reveal>Governance and accountability</p>
    <h2 data-split>What the AI <span class="hl-blue">can</span> and <span class="hl-orange">can't</span> do.</h2>
    <div class="gov-grid">
      <div class="nx-gov nx-gov--ai" data-reveal>
        <span class="nx-gov-tag">AI recommends</span>
        <h3>AI can</h3>
        <p>Classify HS codes and match FTAs with a confidence score. Calculate landed cost and flag uncertain items.</p>
      </div>
      <div class="nx-gov nx-gov--no" data-reveal data-reveal-delay="0.08">
        <span class="nx-gov-tag">Not accountable for decisions</span>
        <h3>AI cannot, by design</h3>
        <p>Write any figure to SAP unapproved. Change its own confidence thresholds. Act without an audit trail entry.</p>
      </div>
      <div class="nx-gov nx-gov--human" data-reveal data-reveal-delay="0.16">
        <span class="nx-gov-tag">Analysts decide</span>
        <h3>Data stays local</h3>
        <p>In region Azure OpenAI, so no trade data leaves Jabil's tenancy. Names and financials are stripped before anything reaches the model.</p>
      </div>
    </div>
  </section>

  <section class="section nx-band outcome">
    <div class="wrap">
      <p class="nx-eyebrow" data-reveal>Business impact and ROI</p>
      <h2 data-split>The numbers that <span class="hl-green">won</span> it.</h2>
      <div class="nx-kpis">
        {roi.map((r, i) => (
          <div class="nx-kpi" style={`--bar:${['#00b4fc', '#30cc48', '#f09c00', '#305478'][i]}`} data-reveal data-reveal-delay={i * 0.06}>
            <span class="nx-kpi-label nx-kpi-label--top">{r.label}</span>
            <span class="nx-kpi-val" style={`color:${['#1468b8', '#1f9a35', '#d98400', '#12306b'][i]}`}>{r.value}</span>
            <span class="nx-kpi-pill">{r.sub}</span>
          </div>
        ))}
      </div>
      <p class="muted outcome-note" data-reveal>
        Built with Eavan Tan, Jessy Pang, Xin Yuan, and Chua Xin Ying for
        Jabil's IT ECP Bootcamp 3.0: <strong>Champion, Use Case 2</strong>.
      </p>
      <a class="nx-btn" href="https://github.com/eavan127/NEXA-AI-Powered-Tariff" target="_blank" rel="noopener" data-reveal>
        View the source on GitHub →
      </a>
    </div>
  </section>

  </div>
</BaseLayout>

<style>
  h1 { font-family: 'Inter', system-ui, sans-serif; font-weight: 800; letter-spacing: -0.02em; text-shadow: 0.06em 0.05em 0 rgba(48, 204, 216, 0.55); }
  .nexa-tagline { font-size: 1.3rem; max-width: 42ch; margin-top: 1.2rem; }
  .nexa-tags { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.8rem; }
  .nexa-tags li { font-size: 0.8rem; font-weight: 550; padding: 0.3rem 0.85rem; border-radius: 999px; border: 1px solid rgba(255, 255, 255, 0.3); background: rgba(0, 24, 72, 0.35); }
  .nexa-tags li:first-child { background: #fc6c18; border-color: transparent; color: #fff; font-weight: 650; }

  /* NEXA skin: the Jabil proposal deck. White slides, teal section labels,
     orange / blue / red highlight words, cyan to blue cover blob, white cards with colour bars. */
  .nexa-skin {
    --ink: #141414; --body: #333; --mut: #5f6672; --line: #e3e8ef;
    --teal: #0e7c86; --navy: #12306b; --slate: #305478; --blue: #1468b8; --sky: #1884cc;
    --orange: #e85d0c; --red: #e43c3c; --amber: #f09c00; --green: #1f9a35;
    --sans: 'Inter', system-ui, sans-serif;
    background: #fff; color: var(--body);
  }
  .nexa-skin :global(h2) { font-family: var(--sans); font-weight: 500; color: var(--ink); letter-spacing: -0.025em; font-size: clamp(2rem, 4.2vw, 3rem); line-height: 1.1; }
  .nexa-skin :global(.hl-red) { color: var(--red); font-weight: 800; }
  .nexa-skin :global(.hl-orange) { color: var(--orange); font-weight: 800; }
  .nexa-skin :global(.hl-blue) { color: var(--sky); font-weight: 800; }
  .nexa-skin :global(.hl-green) { color: var(--green); font-weight: 800; }
  .nexa-skin h3 { font-family: var(--sans); color: var(--ink); font-weight: 700; font-size: 1.05rem; }
  .nexa-skin .muted { color: var(--mut); }
  .nexa-skin strong { color: var(--ink); }
  .nx-eyebrow { font-family: var(--sans); font-size: 0.82rem; font-weight: 800; letter-spacing: 0.02em; text-transform: uppercase; color: var(--teal); margin-bottom: 0.35rem; }
  .nx-band { background: #f4f8fc; max-width: none; }

  /* Cover, after slide 1: white with the cyan / blue glow in the corner. */
  .nx-cover { position: relative; overflow: hidden; background: #fff; padding: clamp(4rem, 10vh, 6.5rem) 0; }
  .nx-blob { position: absolute; top: -18%; right: -10%; width: 62vw; max-width: 900px; aspect-ratio: 1.4; border-radius: 50%;
    background: radial-gradient(closest-side at 55% 45%, #1d4fd8 0%, #2478cc 30%, #30ccd8 58%, rgba(48, 204, 216, 0) 100%);
    filter: blur(40px); opacity: 0.55; pointer-events: none; }
  .nx-cover .wrap { position: relative; }
  .nx-kicker { font-family: var(--sans); font-size: 0.9rem; color: var(--ink); line-height: 1.3; }
  .nx-kicker strong { font-size: 1.25rem; font-weight: 800; }
  .nx-title { font-family: var(--sans); font-weight: 500; font-size: clamp(2.2rem, 5vw, 3.8rem); line-height: 1.05; letter-spacing: -0.03em; color: var(--ink); margin-top: 1rem; max-width: 18ch; }
  .nx-shadow { font-weight: 800; text-shadow: 0.05em 0.05em 0 #30ccd8; }
  .nx-lede { color: var(--mut); margin-top: 1rem; max-width: 54ch; }
  .nx-slides { margin: 2rem 0 0; }
  .nx-frame { position: relative; aspect-ratio: 16 / 9; border-radius: 14px; overflow: hidden; background: #fff; border: 1px solid var(--line); box-shadow: 0 30px 70px -36px rgba(18, 48, 107, 0.55); }
  .nx-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .nx-slides figcaption { display: flex; flex-wrap: wrap; align-items: center; gap: 0.8rem 1.2rem; margin-top: 1rem; font-size: 0.88rem; color: var(--mut); border-top: 1px solid var(--line); padding-top: 0.9rem; }
  .nx-slides figcaption a { margin-left: auto; background: var(--navy); color: #fff; font-weight: 700; font-size: 0.88rem; padding: 0.55rem 1.1rem; border-radius: 8px; text-decoration: none; transition: background 0.15s; }
  .nx-slides figcaption a:hover { background: var(--blue); }

  /* Stat cards, as on the root cause and ROI slides. */
  .nx-kpis { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.1rem; margin-top: 2.2rem; }
  .nx-kpi { position: relative; background: #fff; border-radius: 16px; padding: 1.5rem 1.3rem 1.3rem; display: flex; flex-direction: column; gap: 0.45rem; text-align: center; align-items: center;
    box-shadow: 0 18px 40px -28px rgba(18, 48, 107, 0.45), 0 0 0 1px var(--line); overflow: hidden; }
  .nx-kpi::before { content: ''; position: absolute; inset: 0 0 auto; height: 6px; background: var(--bar, var(--sky)); }
  .nx-kpi-val { font-family: var(--sans); font-weight: 800; font-size: clamp(1.9rem, 3vw, 2.5rem); line-height: 1; letter-spacing: -0.02em; color: var(--ink); }
  .nx-kpi-label { font-family: var(--sans); font-weight: 700; font-size: 0.9rem; color: var(--ink); }
  .nx-kpi-label--top { order: -1; font-size: 0.82rem; }
  .nx-kpi-note { font-size: 0.8rem; color: var(--mut); }
  .nx-kpi-pill { font-size: 0.78rem; font-weight: 600; color: var(--ink); background: #fcf0b4; border-radius: 999px; padding: 0.25rem 0.75rem; }
  .nx-kpi--filled { background: var(--red); box-shadow: 0 18px 40px -24px rgba(228, 60, 60, 0.7); }
  .nx-kpi--filled::before { display: none; }
  .nx-kpi--filled .nx-kpi-val, .nx-kpi--filled .nx-kpi-label { color: #fff; }
  .nx-kpi--filled .nx-kpi-note { color: rgba(255, 255, 255, 0.85); }
  .problem-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; margin-top: 2rem; }

  .nx-panel { margin-top: 2rem; background: #fff; border-radius: 14px; overflow: hidden; box-shadow: 0 0 0 1px var(--line), 0 20px 44px -32px rgba(18, 48, 107, 0.45); }
  .nx-panel-head { display: flex; align-items: center; gap: 0.8rem; padding: 0.8rem 1.4rem; background: var(--navy); color: #fff; }
  .nx-panel-title { flex: 1; font-family: var(--sans); font-weight: 700; font-size: 0.95rem; }
  .nx-live { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.82rem; font-weight: 600; color: #8fe6ee; }
  .nx-live i { width: 7px; height: 7px; border-radius: 50%; background: #30ccd8; animation: nx-blink 2s ease-in-out infinite; }
  @keyframes nx-blink { 50% { opacity: 0.35; } }
  .nx-panel-body { padding: 1.4rem; }
  .nx-panel-body :global(.pipeline) { background: transparent; border: 0; padding: 0; }
  .nx-panel-body :global(.pipeline-stage) { background: #fff; border-color: var(--line); border-top: 4px solid var(--sky); }
  .nx-panel-body :global(.pipeline-num) { color: var(--teal); font-weight: 800; }
  .nx-panel-body :global(.pipeline-arrow) { color: var(--sky); }
  .nx-panel-body :global(.pipeline-gate) { background: #fcf0c0; }
  .nx-panel-body :global(.pipeline-gate h3) { color: #c04800; }

  .demo-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; margin-top: 2.5rem; }

  /* Tier cards, styled like the risk cards: top bar, italic spaced label. */
  .tier-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.1rem; margin-top: 2.5rem; }
  .nx-tier { background: #fff; border-top: 5px solid var(--bar); border-radius: 6px; padding: 1.2rem 1.3rem 1.4rem; box-shadow: 0 0 0 1px var(--line), 0 16px 36px -30px rgba(18, 48, 107, 0.5); }
  .nx-tier-label { display: block; font-family: var(--sans); font-style: italic; font-weight: 700; font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--lab); }
  .nx-tier h3 { margin-top: 0.45rem; }
  .nx-tier p { font-size: 0.92rem; color: var(--body); margin-top: 0.5rem; }

  /* Governance: blue AI band, red line, cream human band. */
  .gov-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.1rem; margin-top: 2.5rem; }
  .nx-gov { border-radius: 10px; padding: 1.3rem 1.4rem; }
  .nx-gov--ai { background: #e6eef8; }
  .nx-gov--no { background: #fff; box-shadow: 0 0 0 1px var(--line); }
  .nx-gov--human { background: #fcf0c0; }
  .nx-gov-tag { display: block; font-family: var(--sans); font-weight: 800; font-size: 0.8rem; text-transform: uppercase; color: var(--blue); margin-bottom: 0.4rem; }
  .nx-gov--no .nx-gov-tag { color: var(--red); }
  .nx-gov--human .nx-gov-tag { color: #c04800; }
  .nx-gov p { font-size: 0.92rem; margin-top: 0.4rem; }

  .outcome-note { margin-top: 2.5rem; max-width: 60ch; }
  .nx-btn { display: inline-flex; margin-top: 1.5rem; background: var(--navy); color: #fff; font-family: var(--sans); font-weight: 700; padding: 0.7rem 1.3rem; border-radius: 8px; text-decoration: none; transition: background 0.15s; }
  .nx-btn:hover { background: var(--blue); }

  @media (max-width: 1000px) { .nx-kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); } .tier-grid, .gov-grid { grid-template-columns: 1fr; } }
  @media (max-width: 800px) { .problem-grid { grid-template-columns: 1fr; } .nx-slides figcaption a { margin-left: 0; } }
  @media (max-width: 480px) { .nx-kpis { grid-template-columns: 1fr; } }
</style>
