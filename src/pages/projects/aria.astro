---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectHero from '../../components/project/ProjectHero.astro';
import ArchitectureDiagram from '../../components/aria/ArchitectureDiagram.astro';
import FireScoreSimulator from '../../components/aria/FireScoreSimulator.astro';
import EvacuationDemo from '../../components/aria/EvacuationDemo.astro';
import NodeExploded from '../../components/aria/NodeExploded.astro';

const sensors = [
  { name: 'MQ-2', role: 'Smoke, LPG & combustibles, the first hint something is burning' },
  { name: 'MQ-7', role: 'Carbon monoxide, converted to a ppm estimate: the silent killer check' },
  { name: 'MQ-135', role: 'Chemical air quality that catches what smoke sensors miss' },
  { name: 'Flame sensor', role: 'Direct IR flame detection, triple-read to reject sunlight' },
  { name: 'DHT11', role: 'Temperature & humidity to separate steam from fire' },
  { name: 'LDR + laser', role: 'Beam-break people counting at every exit for congestion detection' },
];
// Badge colours from the ARIA slide deck (Key Features).
const sensorColors = ['#D83048', '#F05A2A', '#3A78F0', '#248478', '#6C48D8', '#0F5B55'];
const sensorTints = ['#FCD3D6', '#FBE1C6', '#D6E5FD', '#D3EBE6', '#E3DBFA', '#D3EBE6'];
const galleryImages = [
  { src: '/images/aria/dashboard-warden.png', alt: 'ARIA dashboard, warden tab: zone scores, alert pills, live floor map and escape-route canvas' },
  { src: '/images/aria/dashboard-technical.png', alt: 'ARIA dashboard, technical tab: per-node sensor detail and live system log' },
];
---
<BaseLayout
  overlayNav
  theme="aria"
  title="ARIA: distributed fire detection | Eileen Yeoh"
  description="A 6-node ESP32 wireless sensor network that tells real fires from cooking smoke and routes people to safe exits. Interactive deep-dive."
>
  <ProjectHero img="/images/projects-hero/makerthon.jpg" alt="Team INTERA with ARIA at USM IEEE Makerthon 2026" caption="Team INTERA with ARIA at USM IEEE Makerthon 2026, themed around wireless communication and IoT integration." post="https://www.linkedin.com/feed/update/urn:li:activity:7460617463857074176/" event="#F05A2A">
    
    <p class="eyebrow" data-reveal>Project 01 · 2025 to 2026</p>
    <h1 class="aria-word"><span class="ab">A</span><span class="ao">R</span><span class="ab">I</span><span class="ao">A</span></h1>
    <p class="aria-tagline" data-reveal>
      Adaptive Room Intelligence &amp; Alert: a wireless sensor
      network that knows the difference between a fire and your breakfast.
    </p>
    <ul class="aria-tags" data-reveal>
      {['ESP32', 'ESP-NOW', 'multi-sensor fusion', 'embedded C++', 'WebSocket dashboard'].map((t) => <li>{t}</li>)}
    </ul>
  </ProjectHero>
  <div class="aria-skin">

  <section class="section wrap aria-media" id="watch">
    <p class="eyebrow" data-reveal>Watch and present</p>
    <h2 data-split>See ARIA in action.</h2>
    <div class="media-grid">
      <figure class="media-card media-card--short">
        <div class="media-frame media-frame--short">
          <iframe src="https://www.youtube-nocookie.com/embed/boeAy7aZ5Lw?rel=0" title="ARIA introduction video by Team INTERA" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
        </div>
        <figcaption><strong>Introduction video</strong><span class="muted">Team INTERA's short for USM IEEE Makerthon 2026.</span><a href="https://youtube.com/shorts/boeAy7aZ5Lw" target="_blank" rel="noopener">Watch on YouTube ↗</a></figcaption>
      </figure>
      <figure class="media-card">
        <div class="media-frame">
          <iframe src="https://www.canva.com/design/DAHHujOgb00/LF3JcT4Qd77NWflWBTwhPA/view?embed" title="ARIA presentation slides" allow="fullscreen" allowfullscreen loading="lazy"></iframe>
        </div>
        <figcaption><strong>Presentation slides</strong><span class="muted">The deck we pitched with. Use the arrows to flip through.</span><a href="https://www.canva.com/design/DAHHujOgb00/LF3JcT4Qd77NWflWBTwhPA/view" target="_blank" rel="noopener">Open in Canva ↗</a></figcaption>
      </figure>
    </div>
  </section>


  <section class="section wrap">
    <p class="eyebrow" data-reveal>The problem</p>
    <h2 data-split>Smoke detectors cry wolf.</h2>
    <div class="problem-grid">
      <p data-reveal>
        A single smoke sensor can't tell combustion from cooking. Steam, haze,
        and a hot wok all push the same reading up, so alarms get ignored,
        batteries get pulled, and real fires get a head start.
      </p>
      <p data-reveal>
        ARIA's answer: never trust one sensor. Each node fuses smoke, carbon
        monoxide, air quality, flame, temperature, and humidity into a single
        0 to 10 fire score, and evidence <em>against</em> fire subtracts points.
      </p>
    </div>
  </section>

  <section class="section wrap">
    <p class="eyebrow" data-reveal>The system</p>
    <h2 data-split>One hub. Six nodes. No router.</h2>
    <p class="muted" data-reveal>
      Nodes broadcast sensor packets to the hub every 500 ms over ESP-NOW.
      The hub aggregates zone scores, drives LED evacuation strips, serves a
      live dashboard over its own Wi-Fi access point, and pushes Telegram
      alerts.
    </p>
    <ArchitectureDiagram />
  </section>

  <section class="section wrap">
    <p class="eyebrow" data-reveal>Try it · the scoring algorithm</p>
    <h2 data-split>Score the room yourself.</h2>
    <p class="muted" data-reveal>
      Set the sensors and watch the fire score react, including the
      false-alarm patterns that <em>subtract</em> evidence. Try "Burnt toast":
      heavy smoke, but clean CO and air quality means no alarm.
    </p>
    <FireScoreSimulator />
  </section>

  <section class="section wrap">
    <p class="eyebrow" data-reveal>Try it · evacuation routing</p>
    <h2 data-split>Set a fire. Watch the exits think.</h2>
    <p class="muted" data-reveal>
      This is the hub's real logic on the dashboard's T-shaped floor plan.
      Click a room to start a fire: people flow toward the safe exit, and the
      hub's LED strip chases green toward it, red away from fire. Turn up the
      crowd at an exit and its laser-beam counter decides when it is
      congested.
    </p>
    <EvacuationDemo />
  </section>

  <section class="section wrap">
    <p class="eyebrow" data-reveal>Hardware · node teardown</p>
    <h2 data-split>Anatomy of a node.</h2>
    <p class="muted" data-reveal>
      Keep scrolling: the case lifts off and every component files out for
      inspection. All of it fits in a 90 × 120 × 45 mm ventilated enclosure.
    </p>
    <NodeExploded />
  </section>

  <section class="section wrap">
    <p class="eyebrow" data-reveal>Hardware</p>
    <h2 data-split>Six senses per node.</h2>
    <div class="sensor-grid">
      {sensors.map((s, i) => (
        <div class="card sensor-card" style={`--sc:${sensorColors[i % sensorColors.length]};--st:${sensorTints[i % sensorTints.length]}`} data-reveal data-reveal-delay={i * 0.06}>
          <span class="sensor-n">{i + 1}</span>
          <h3>{s.name}</h3>
          <p class="muted sensor-role">{s.role}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section wrap">
    <p class="eyebrow" data-reveal>The dashboard</p>
    <h2 data-split>Mission control in a browser.</h2>
    <p class="muted" data-reveal>
      The hub serves a live dashboard from its own Wi-Fi access point, no
      internet needed. Fire wardens see zone scores, SOS locations, and a live
      floor map; engineers get per-node telemetry and a real-time system log.
    </p>
    <div class="gallery">
      {galleryImages.map((img) => (
        <figure class="card gallery-item" data-reveal>
          <img src={img.src} alt={img.alt} loading="lazy" width="1280" height="800" />
        </figure>
      ))}
    </div>
  </section>

  <section class="section wrap outcome">
    <p class="eyebrow" data-reveal>Outcome</p>
    <h2 data-split>What I learned building it.</h2>
    <div class="outcome-grid">
      <div data-reveal>
        <h3>Calibration beats specification.</h3>
        <p class="muted">MQ sensors drift with every room. ARIA self-calibrates 30 samples at startup and sets thresholds relative to its own baseline.</p>
      </div>
      <div data-reveal data-reveal-delay="0.08">
        <h3>Radios fight for airtime.</h3>
        <p class="muted">ESP-NOW, Wi-Fi AP, and WS2812B timing all share one chip. Pinning the channel and disabling Wi-Fi power-save kept packets and pixels stable.</p>
      </div>
      <div data-reveal data-reveal-delay="0.16">
        <h3>Negative evidence matters.</h3>
        <p class="muted">The fire score improved most when contradictory signals started subtracting points. That's what finally beat the burnt-toast false alarm.</p>
      </div>
    </div>
    <a class="btn" href="https://github.com/EileenYJH/ARIA" target="_blank" rel="noopener" data-reveal>
      View the full source on GitHub →
    </a>
  </section>
  </div>
</BaseLayout>

<style>
  /* ARIA follows its Makerthon slide deck: deep teal bars, mint panels, dashed diamonds and bright numbered badges. */
  :global(.ph-title) .aria-word { letter-spacing: -0.03em; }
  .aria-word .ab { color: #6FA3FF; }
  .aria-word .ao { color: #FF8A5B; }
  .aria-skin { --teal: #0B4A47; --teal-2: #248478; --mint: #E6F3F0; --mint-2: #CFE7E1; }
  .aria-skin > section { position: relative; }
  .aria-skin > section:nth-of-type(even) { background: var(--mint); max-width: none; width: 100%; padding-inline: max(1.5rem, calc((100% - var(--content-w)) / 2)); }
  .aria-skin > section:nth-of-type(even)::before,
  .aria-skin > section:nth-of-type(even)::after {
    content: ''; position: absolute; width: 70px; height: 70px; transform: rotate(45deg);
    border: 2px dashed rgba(36, 132, 120, 0.45); pointer-events: none;
  }
  .aria-skin > section:nth-of-type(even)::before { top: 28px; right: 38px; }
  .aria-skin > section:nth-of-type(even)::after { bottom: 28px; left: 34px; width: 44px; height: 44px; background: rgba(36, 132, 120, 0.12); border-style: solid; border-color: transparent; }
  .aria-skin .eyebrow {
    display: inline-block; background: var(--teal); color: #fff;
    padding: 0.4rem 1rem; border-radius: 4px;
    font-weight: 800; font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase;
    box-shadow: 6px 6px 0 rgba(36, 132, 120, 0.25);
  }
  .aria-skin .eyebrow::before { background: #F05A2A; }
  .aria-skin :global(h2) { color: var(--teal); }
  .aria-skin .sensor-card { position: relative; border: 0; border-top: 6px solid var(--sc); background: #fff; padding-top: 1.4rem; }
  .aria-skin .sensor-card h3 { display: inline-block; background: var(--st); padding: 0.2rem 0.6rem; border-radius: 4px; font-size: 0.95rem; letter-spacing: 0.04em; text-transform: uppercase; }
  .sensor-n { position: absolute; top: -18px; right: 16px; width: 34px; height: 34px; display: grid; place-items: center; color: #fff; font-weight: 800; z-index: 0; }
  .sensor-n::before { content: ''; position: absolute; inset: 0; z-index: -1; background: var(--sc); border-radius: 6px; transform: rotate(45deg); }
  .aria-skin .outcome-grid > div { background: #fff; border-radius: 12px; padding: 1.3rem 1.4rem; border-left: 6px solid var(--teal-2); box-shadow: 0 16px 34px -26px rgba(11, 74, 71, 0.5); }
  .aria-skin .outcome-grid > div:nth-child(2) { border-left-color: #F05A2A; }
  .aria-skin .outcome-grid > div:nth-child(3) { border-left-color: #3A78F0; }
  .aria-skin .gallery-item { background: #fff; border: 2px solid var(--mint-2); }
  .aria-skin .btn { background: var(--teal); border-color: var(--teal); color: #fff; }

  .aria-media h2 { margin-bottom: 1.6rem; }
  .media-grid { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 2.6fr); gap: 1.6rem; align-items: start; }
  .media-frame.media-frame--short { aspect-ratio: 9 / 16; }
  @media (max-width: 800px) { .media-grid { grid-template-columns: 1fr; } .media-card--short { max-width: 340px; } }
  .media-card { margin: 0; }
  .media-frame { position: relative; aspect-ratio: 16 / 9; border-radius: 14px; overflow: hidden; background: #0B0F1C; box-shadow: 0 24px 50px -30px rgba(var(--accent-rgb), 0.6); }
  .media-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .media-card figcaption { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.3rem 0.8rem; margin-top: 0.7rem; font-size: 0.92rem; }
  .media-card figcaption a { margin-left: auto; color: var(--accent); font-weight: 600; text-decoration: none; }

  .aria-hero { position: relative; }
  .aria-hero h1 { font-size: clamp(4rem, 14vw, 9rem); }
  .aria-tagline { font-size: 1.3rem; max-width: 38ch; margin-top: 1.2rem; }
  .aria-tags { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.8rem; }
  .aria-tags li {
    font-size: 0.8rem;
    font-weight: 550;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--paper-raised);
  }
  .problem-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; margin-top: 2rem; }
  .sensor-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.2rem;
    margin-top: 2.5rem;
  }
  .sensor-role { font-size: 0.9rem; margin-top: 0.4rem; }
  .gallery { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-top: 2.5rem; }
  .gallery-item { padding: 0.6rem; }
  .gallery-item img { border-radius: calc(var(--radius) - 6px); }
  .outcome-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 2rem; margin-top: 2.5rem; }
  .outcome .btn { margin-top: 3rem; }
  @media (max-width: 800px) {
    .problem-grid { grid-template-columns: 1fr; }
    .gallery { grid-template-columns: 1fr; }
  }
</style>
