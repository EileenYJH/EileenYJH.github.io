---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProcessFlow from '../../components/mosfet/ProcessFlow.astro';
import ProjectHero from '../../components/project/ProjectHero.astro';

const stats = [
  { value: '4', label: 'photomasks', sub: 'source/drain · gate · contacts · metal' },
  { value: '495.8 nm', label: 'field oxide', sub: 'wet oxidation, 1050 °C · 60 min' },
  { value: '19.8 nm', label: 'gate oxide', sub: 'dry oxidation, 1000 °C · 90 min' },
  { value: '6', label: 'dies probed', sub: 'drain-current sweeps at 5 to 10 V gate bias' },
];

const litho = [
  ['Coat', 'Positive photoresist spun on'],
  ['Soft bake', '90 °C · 90 s'],
  ['Expose', 'UV through the mask · 110 s, yellow room'],
  ['Develop', '30 s: exposed resist dissolves'],
  ['Hard bake', '90 °C · 60 s'],
  ['Etch', 'BOE 180 s (Al etch 60 s for Mask 4)'],
  ['Strip', 'Acetone, ready for the next step'],
];

const causes = [
  { t: 'Gate oxide thickness', d: 'A thin oxide raises Cₒₓ = εₒₓ/tₒₓ and strengthens gate control. Grow it thicker than intended and the threshold rises while drive current falls.' },
  { t: 'Doping & diffusion', d: 'Too little drive-in time or temperature gives shallow junctions and higher sheet resistance: parasitic series resistance that throttles current.' },
  { t: 'Contacts & metallization', d: 'Uneven aluminium or poor annealing can form a Schottky barrier instead of an ohmic contact, a plausible driver of the ~3.9× spread between dies tested at the same bias.' },
];
---
<BaseLayout
  overlayNav
  theme="mosfet"
  title="NMOS fabrication | Eileen Yeoh"
  description="An n-channel enhancement-mode MOSFET fabricated by hand through a four-mask cleanroom process, then characterised and debugged against theory."
>
  <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Dela+Gothic+One&family=Lato:wght@400;700;900&display=swap" />
  <ProjectHero img="/images/projects-hero/mosfet.jpg" alt="Our four person team in cleanroom suits at ADTEC Taiping" caption="Session 1 Group 1 suited up in the ADTEC Taiping cleanroom for two days of fabrication." event="#5EF0A8" focus="50% 45%">
    <p class="eyebrow" data-reveal>Project 05 · 2026 · EFB1074 Microelectronic Physics and Devices (MPD), UTP</p>
    <h1 class="ph-h1--long">MOSFET Fabrication &amp; Electrical Characterization</h1>
    <p class="mos-sub" data-reveal>Building a transistor from bare silicon</p>
    <p class="mos-tagline" data-reveal>
      A whole n-channel MOSFET, grown, patterned, doped and wired by hand in a
      cleanroom, then probed to see whether it actually switches.
    </p>
    <ul class="mos-tags" data-reveal>
      {['Cleanroom · ADTEC Taiping', 'Thermal oxidation', 'Photolithography', 'Phosphorus diffusion', 'Al PVD'].map((t) => <li>{t}</li>)}
    </ul>
  </ProjectHero>

  <div class="mos-skin">
  <svg class="mos-wave mos-wave--tr" viewBox="0 0 400 400" aria-hidden="true">{Array.from({ length: 16 }, (_, i) => <ellipse cx="300" cy="80" rx={60 + i * 14} ry={34 + i * 9} transform={`rotate(${-18 + i * 1.5} 300 80)`} />)}</svg>

  <section class="section wrap">
    <div class="stat-grid">
      {stats.map((s, i) => (
        <div class="stat-card" data-reveal data-reveal-delay={i * 0.06}>
          <span class="stat-value">{s.value}</span>
          <span class="stat-label">{s.label}</span>
          <span class="stat-sub muted">{s.sub}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="section wrap" id="montage">
    <p class="eyebrow" data-reveal>Inside the cleanroom</p>
    <h2 data-split>The montage.</h2>
    <div class="mos-video" data-reveal>
      <iframe data-autoplay src="https://www.youtube-nocookie.com/embed/ZzR8kaybJIM?rel=0&playsinline=1" title="MOSFET fabrication cleanroom montage, Session 1 Group 1" allow="autoplay; accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen" allowfullscreen loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
    </div>
    <p class="muted mos-video-cap" data-reveal>Our two days at ADTEC Taiping, from gowning up to probing the finished dies. <a href="https://youtu.be/ZzR8kaybJIM" target="_blank" rel="noopener">Watch on YouTube ↗</a></p>
  </section>

  <section class="section wrap" id="slides">
    <p class="eyebrow" data-reveal>Presentation &amp; report</p>
    <h2 data-split>How we presented it.</h2>
    <div class="mos-media">
      <figure class="mos-slides" data-reveal>
        <div class="mos-video">
          <iframe src="https://www.canva.com/design/DAHO-U_XDFY/4YIUXGOKDRBp2lAjl_rETg/view?embed" title="MOSFET Fabrication and Electrical Characterization presentation slides" allow="fullscreen" allowfullscreen loading="lazy"></iframe>
        </div>
        <figcaption class="muted mos-video-cap">Our 16 slide presentation. Use the arrows to flip through. <a href="https://www.canva.com/design/DAHO-U_XDFY/4YIUXGOKDRBp2lAjl_rETg/view" target="_blank" rel="noopener">Open in Canva ↗</a></figcaption>
      </figure>
      <a class="mos-report card" href="https://docs.google.com/document/d/1zpX4IY3g4UEPFZq8Xgd9fK4STLb8zTZRT32NanGTmZg/preview" target="_blank" rel="noopener" data-reveal>
        <span class="mos-report-tag">Lab report</span>
        <strong>MOSFET Fabrication &amp; Electrical Characterization</strong>
        <span class="muted">The full write up: theory, run card, oxide thickness, I-V data and the probe reversal diagnosis.</span>
        <span class="mos-report-cta">Read the report ↗</span>
      </a>
    </div>
  </section>

  <section class="section wrap">
    <p class="eyebrow" data-reveal>The process</p>
    <h2 data-split>Ten steps from wafer to working device.</h2>
    <p class="muted" data-reveal>
      Click a step to see the wafer's cross-section at that point in the run.
    </p>
    <ProcessFlow />
  </section>

  <section class="section wrap">
    <p class="eyebrow" data-reveal>The patterning backbone</p>
    <h2 data-split>One lithography cycle, repeated four times.</h2>
    <ol class="litho" data-reveal>
      {litho.map(([t, d], i) => (
        <li>
          <span class="litho-num">{String(i + 1).padStart(2, '0')}</span>
          <strong>{t}</strong>
          <span class="muted">{d}</span>
        </li>
      ))}
    </ol>
    <div class="card note" data-reveal>
      <h3>⚠️ The run we had to restart</h3>
      <p class="muted">
        On Mask 1 the BOE bath wasn't agitated enough, so the oxide under-etched.
        A second dip over-corrected and over-etched the source/drain windows past
        their dimensions, and the wafer had to be started again from scratch.
        A lesson in how unforgiving wet etching is.
      </p>
    </div>
  </section>

  <section class="section wrap">
    <p class="eyebrow" data-reveal>Results</p>
    <h2 data-split>The curve that looked right, and wasn't.</h2>
    <div class="two-col">
      <div data-reveal>
        <h3>What theory predicts</h3>
        <p class="muted">
          From the measured oxide thickness, a square-law model gives the
          textbook family of curves: current starts at zero, rises through the
          triode region, then flattens in saturation at about 40.7 mA at
          V<sub>GS</sub> = 10 V.
        </p>
      </div>
      <div data-reveal>
        <h3>What the probes said</h3>
        <p class="muted">
          The raw (negative) data seemed to show the same triode-to-saturation
          shape. Taking absolute values revealed the truth: current peaked at
          V<sub>DS</sub> = 0 V (up to 63.8 mA) and decayed across the sweep,
          which is physically impossible for a correctly wired device.
        </p>
      </div>
    </div>
    <div class="card diagnosis" data-reveal>
      <h3>🔍 Diagnosis: reversed source/drain probes</h3>
      <p class="muted">
        Swapped probe connections shifted the effective gate bias during each
        sweep, so the "saturation" curve was a sign-convention illusion. Even
        so, five of six dies carried tens of milliamps, far above any leakage
        floor, so the transistors themselves work. The one outlier at
        V<sub>GS</sub> = 5 V loosely bounds the threshold between 5 and 8 V.
      </p>
    </div>
  </section>

  <section class="section wrap">
    <p class="eyebrow" data-reveal>Fabrication → electrical behaviour</p>
    <h2 data-split>Every cleanroom choice shows up in the I-V curve.</h2>
    <div class="cause-list">
      {causes.map((c, i) => (
        <div class="cause" data-reveal data-reveal-delay={i * 0.08}>
          <span class="cause-n">{String(i + 1).padStart(2, '0')}</span>
          <h3>{c.t}</h3>
          <p>{c.d}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section wrap outcome">
    <p class="eyebrow" data-reveal>Team &amp; my part</p>
    <h2 data-split>Four of us, one wafer.</h2>
    <p class="muted outcome-note" data-reveal>
      Fabricated with Nicholas Tan Hong Junn, Muhammad Aqeef Qaer Bin Karim and
      Siew Hui. We ran the cleanroom process as a group; in the report I wrote
      the introduction and the semiconductor-physics background and theory:
      inversion, the three operating regions, and the square-law model the
      results are measured against.
    </p>
    <a class="btn" href="#montage" data-reveal>
      Watch the cleanroom montage ↑
    </a>
  </section>
  <svg class="mos-wave mos-wave--bl" viewBox="0 0 400 400" aria-hidden="true">{Array.from({ length: 16 }, (_, i) => <ellipse cx="90" cy="330" rx={60 + i * 14} ry={34 + i * 9} transform={`rotate(${12 - i * 1.5} 90 330)`} />)}</svg>
  </div>
</BaseLayout>

<script>
  // Start the montage muted as soon as it scrolls into view, so it plays right on the page.
  const yt = document.querySelector<HTMLIFrameElement>('iframe[data-autoplay]');
  if (yt && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const io = new IntersectionObserver(([e]) => {
      if (e.isIntersecting) { yt.src = yt.src + '&autoplay=1&mute=1'; io.disconnect(); }
    }, { threshold: 0.5 });
    io.observe(yt);
  }
</script>

<style>
  /* MOSFET skin: the S1G1 presentation. White slides with sky line-art waves,
     heavy wide uppercase titles on a mint band, teal section labels, teal to
     navy chevrons, green emphasis. */
  .mos-skin {
    --teal: #138a8a; --teal-l: #5fd1c8; --navy: #0d3557; --mint: #5ef0a8; --green: #1a9e48; --sky: #5ec8f0;
    --ink: #111; --body: #333; --line: #e3eef0;
    position: relative; overflow: hidden; background: #fff; color: var(--body); font-family: 'Lato', system-ui, sans-serif;
  }
  .mos-wave { position: absolute; width: 520px; height: 520px; pointer-events: none; fill: none; stroke: var(--sky); stroke-width: 1; opacity: 0.55; z-index: 0; }
  .mos-wave--tr { top: -120px; right: -160px; }
  .mos-wave--bl { bottom: -180px; left: -170px; }
  .mos-skin > section { position: relative; z-index: 1; }
  .mos-skin :global(.eyebrow) { font-family: 'Lato', sans-serif; font-weight: 900; text-transform: uppercase; letter-spacing: 0.02em; color: var(--teal); font-size: 0.9rem; }
  .mos-skin :global(.eyebrow)::before { display: none; }
  .mos-skin :global(h2) {
    font-family: 'Dela Gothic One', 'Arial Black', sans-serif; font-weight: 400; text-transform: uppercase; color: var(--ink); letter-spacing: 0.02em;
    display: inline-block; position: relative; padding: 0.15em 0.4em 0.15em 0.35em; margin-left: -0.35em;
    background: linear-gradient(90deg, var(--mint) 0%, rgba(94, 240, 168, 0.55) 45%, rgba(94, 240, 168, 0) 100%);
  }
  .mos-skin :global(h2)::after { content: ''; position: absolute; left: 0; bottom: -10px; width: 14px; height: 14px; border-left: 3px solid var(--green); border-bottom: 3px solid var(--green); }
  .mos-skin :global(h2) { font-size: clamp(1.5rem, 3.4vw, 2.4rem); line-height: 1.35; }
  .mos-skin :global(h2 .split-line) { overflow: visible !important; padding-bottom: 0.08em; }
  .mos-skin h3 { font-family: 'Lato', sans-serif; font-weight: 900; color: var(--ink); }
  .mos-skin strong { color: var(--green); }
  .mos-skin .muted { color: #555; }
  h1 { font-family: 'Dela Gothic One', 'Arial Black', sans-serif; font-weight: 400; text-transform: uppercase; letter-spacing: 0.02em; line-height: 1.2 !important; }
  .mos-sub { font-family: 'Lato', sans-serif; font-weight: 700; color: #5ef0a8 !important; font-size: 1.35rem; margin-top: 1.2rem; }
  .mos-tagline { font-size: 1.2rem; max-width: none; margin-top: 0.6rem; }
  .mos-tags { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.8rem; }
  .mos-tags { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1.6rem; }
  .mos-tags li { font-size: 0.8rem; font-weight: 700; padding: 0.35rem 0.9rem; border-radius: 4px; color: #fff; background: linear-gradient(90deg, #5fd1c8, #138a8a) !important; border: 0 !important; }
  .mos-tags li:first-child { background: #0d3557 !important; color: #fff !important; }
  .mos-tagline { font-size: 1.2rem; margin-top: 0.6rem; }

  /* stats: chevron headers like the process flow slide */
  .stat-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.5rem; }
  .stat-card { display: flex; flex-direction: column; gap: 0.4rem; }
  .stat-label { order: -1; color: #fff; font-weight: 900; font-size: 0.85rem; text-transform: uppercase; padding: 0.7rem 1.6rem 0.7rem 1rem; clip-path: polygon(0 0, calc(100% - 16px) 0, 100% 50%, calc(100% - 16px) 100%, 0 100%, 16px 50%); background: var(--c); }
  .stat-card:first-child .stat-label { clip-path: polygon(0 0, calc(100% - 16px) 0, 100% 50%, calc(100% - 16px) 100%, 0 100%); }
  .stat-card:nth-child(1) { --c: #7fe0d0; } .stat-card:nth-child(2) { --c: #3fb3b0; } .stat-card:nth-child(3) { --c: #1d7f90; } .stat-card:nth-child(4) { --c: var(--navy); }
  .stat-value { font-family: 'Dela Gothic One', sans-serif; font-size: 1.9rem; color: var(--teal); padding: 0.4rem 0.6rem 0; }
  .stat-sub { font-size: 0.84rem; padding: 0 0.6rem; }

  .mos-video { position: relative; aspect-ratio: 16 / 9; margin-top: 2rem; border-radius: 6px; overflow: hidden; background: #111; box-shadow: 0 0 0 4px #fff, 0 0 0 6px var(--mint), 0 30px 60px -36px rgba(13, 53, 87, 0.7); }
  .mos-video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .mos-video-cap { margin-top: 1rem; font-size: 0.92rem; }
  .mos-video-cap a { color: var(--teal); font-weight: 900; margin-left: 0.3rem; }
  .mos-media { display: grid; grid-template-columns: minmax(0, 2.4fr) minmax(0, 1fr); gap: 1.6rem; align-items: start; margin-top: 0.5rem; }
  .mos-slides { margin: 0; }
  .mos-report { display: flex; flex-direction: column; gap: 0.6rem; margin-top: 2rem; padding: 1.4rem; text-decoration: none; color: inherit; background: linear-gradient(90deg, #eafbf3, #fff); border-left: 6px solid var(--green); border-radius: 4px; box-shadow: 0 0 0 1px var(--line); transition: transform 0.2s; }
  .mos-report:hover { transform: translateY(-3px); }
  .mos-report-tag { font-size: 0.78rem; font-weight: 900; text-transform: uppercase; color: var(--teal); }
  .mos-report strong { font-size: 1.1rem; color: var(--ink); }
  .mos-report-cta { margin-top: 0.4rem; font-weight: 900; color: var(--green); }

  /* lithography: chevron row */
  .litho { list-style: none; padding: 0; margin-top: 2.5rem; display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 0.3rem; }
  .litho li { display: flex; flex-direction: column; gap: 0.5rem; font-size: 0.85rem; }
  .litho li strong { order: -1; color: #fff; font-size: 0.92rem; padding: 0.75rem 1.3rem 0.75rem 1.2rem; clip-path: polygon(0 0, calc(100% - 14px) 0, 100% 50%, calc(100% - 14px) 100%, 0 100%, 14px 50%); background: var(--c); }
  .litho li:first-child strong { clip-path: polygon(0 0, calc(100% - 14px) 0, 100% 50%, calc(100% - 14px) 100%, 0 100%); }
  .litho-num { font-family: 'Dela Gothic One', sans-serif; font-size: 0.8rem; color: var(--teal); padding: 0 0.5rem; }
  .litho li .muted { padding: 0 0.5rem; }
  .litho li:nth-child(1) { --c: #8fe6d6; } .litho li:nth-child(2) { --c: #6dd2c7; } .litho li:nth-child(3) { --c: #4bbdb8; } .litho li:nth-child(4) { --c: #2fa3a7; }
  .litho li:nth-child(5) { --c: #1d8796; } .litho li:nth-child(6) { --c: #15677f; } .litho li:nth-child(7) { --c: var(--navy); }

  .card { background: #fff; border: 1px solid var(--line); border-radius: 4px; padding: 1.3rem 1.4rem; }
  .note, .diagnosis { margin-top: 1.5rem; background: linear-gradient(90deg, #eafbf3, #fff); border: 0; border-left: 6px solid var(--green); box-shadow: 0 0 0 1px var(--line); }
  .diagnosis { border-left-color: var(--teal); background: linear-gradient(90deg, #e6f6f7, #fff); }
  .note p, .diagnosis p { font-size: 0.93rem; margin-top: 0.4rem; }
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; margin-top: 2rem; }
  .two-col > div { padding: 1.2rem 1.3rem; border-radius: 4px; box-shadow: 0 0 0 1px var(--line); }
  .two-col > div h3 { display: inline-block; color: #fff; font-size: 0.9rem; text-transform: uppercase; padding: 0.45rem 1.4rem 0.45rem 0.8rem; margin: -1.2rem 0 0.4rem -1.3rem; clip-path: polygon(0 0, calc(100% - 12px) 0, 100% 50%, calc(100% - 12px) 100%, 0 100%); background: var(--teal); }
  .two-col > div:last-child h3 { background: var(--navy); }
  .two-col p { margin-top: 0.4rem; }

  /* causes: numbered chevrons, as on the fabrication-parameters slide */
  .cause-list { display: grid; gap: 0.9rem; margin-top: 2.2rem; }
  .cause { display: grid; grid-template-columns: 110px minmax(0, 1fr) minmax(0, 1.6fr); align-items: center; gap: 1.2rem; }
  .cause-n { display: grid; place-items: center; height: 84px; font-family: 'Dela Gothic One', sans-serif; font-size: 1.6rem; color: #fff; clip-path: polygon(0 0, calc(100% - 26px) 0, 100% 50%, calc(100% - 26px) 100%, 0 100%); background: var(--c); }
  .cause:nth-child(1) { --c: #4fc9c0; } .cause:nth-child(2) { --c: #2a9aa6; } .cause:nth-child(3) { --c: #1a6a86; }
  .cause h3 { font-size: 1rem; }
  .cause p { font-size: 0.9rem; padding: 0.9rem 1.1rem; background: linear-gradient(90deg, #eef8f8, #fff); border-left: 5px solid var(--green); border-radius: 3px; }

  .outcome-note { margin-top: 1.5rem; max-width: none; }
  .btn { display: inline-flex; margin-top: 1.5rem; background: var(--navy); color: #fff; font-weight: 900; padding: 0.7rem 1.3rem; border-radius: 4px; text-decoration: none; }
  .btn:hover { background: var(--teal); }

  /* process flow cross-section in the slide colours */
  .mos-skin :global(.l-ox), .mos-skin :global(.l-gox) { fill: #c9f7e0; stroke: var(--teal); }
  .mos-skin :global(.sw-ox) { background: #c9f7e0; border-color: var(--teal); }

  @media (max-width: 900px) {
    .stat-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 1.2rem; }
    .stat-card .stat-label { clip-path: polygon(0 0, calc(100% - 16px) 0, 100% 50%, calc(100% - 16px) 100%, 0 100%); }
    .litho { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 1rem; }
    .litho li strong { clip-path: polygon(0 0, calc(100% - 14px) 0, 100% 50%, calc(100% - 14px) 100%, 0 100%); }
    .mos-media, .two-col { grid-template-columns: 1fr; }
    .cause { grid-template-columns: 80px 1fr; }
    .cause p { grid-column: 1 / -1; }
  }
</style>
