---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkList from '../../components/home/WorkList.astro';
---
<BaseLayout title="Projects | Eileen Yeoh" description="Engineering projects by Eileen Yeoh: semiconductor fabrication, power electronics, embedded IoT and applied AI, each with an interactive deep-dive.">
  <section class="section wrap">
    <h1>Projects</h1>
    <p class="lede muted">
      From hand-fabricated transistors to multi-agent AI. Each one has its own
      page with the design decisions, the results and what went wrong.
    </p>
    <WorkList />
  </section>
</BaseLayout>

<style>
  h1 { font-size: clamp(3rem, 8vw, 6rem); letter-spacing: -0.04em; }
  .lede { font-size: 1.2rem; margin-top: 1rem; max-width: 52ch; }
</style>
