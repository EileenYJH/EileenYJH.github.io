---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoWall from '../components/home/PhotoWall.astro';
import WorkList from '../components/home/WorkList.astro';

const LINKEDIN = 'https://www.linkedin.com/in/eileen-yeoh-jing-han-7ba86a214/';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmt = new Intl.DateTimeFormat('en', { day: 'numeric', month: 'short', year: 'numeric' });

const now = [
  { role: 'Study Abroad student', org: 'University of Sheffield, UK · 2026/27' },
  { role: 'Electrical & Electronic Engineering undergraduate', org: 'Universiti Teknologi PETRONAS, Malaysia' },
  { role: 'Project Director', org: 'Electrical & Electronics Engineering Student Society (E3S2)' },
  { role: 'Secretary', org: 'Open Computing Club (OCC)' },
  { role: 'Newsletter Editor', org: 'IEEE UTP Student Branch' },
];

const recognition = [
  { what: 'Champion, Use Case 2', where: 'Jabil IT ECP Bootcamp 3.0', href: '/projects/nexa' },
  { what: 'Student Excellence Award', where: 'UTP Foundation Programme, 2025' },
  { what: 'All judged classes above the 80% bar', where: 'SEDIC 2026 RF/Signal Track', href: '/projects/sedic' },
];
---
<BaseLayout
  overlayNav
  title="Eileen Yeoh — electrical & electronic engineering"
  description="Eileen Yeoh is an electrical and electronic engineering student at UTP, studying abroad at the University of Sheffield. Projects across semiconductor fabrication, power electronics, embedded IoT and applied AI."
>
  <section class="hero">
    <PhotoWall />
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <p class="hero-hello">Hello, I'm</p>
      <h1 class="hero-name">Eileen Yeoh</h1>
      <svg class="hero-trace" viewBox="0 0 600 40" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 20 C 15 -6, 30 -6, 45 20 S 75 46, 90 20 S 118 2, 132 20 S 156 34, 168 20 S 188 10, 198 20 S 214 27, 224 20 S 240 15, 250 20 S 262 23, 272 20 L 600 20" />
      </svg>
      <p class="hero-lede">
        Electrical and electronic engineering student. I build across the
        stack: from a transistor fabricated by hand in a cleanroom to AI that
        picks jammers out of raw radio.
      </p>
      <p class="hero-where">UTP, Malaysia · Study Abroad at the University of Sheffield, UK</p>
      <div class="hero-actions">
        <a class="btn btn--trace" href="#work">See my projects</a>
        <a class="btn btn--glass" href={LINKEDIN} target="_blank" rel="noopener">Connect on LinkedIn</a>
      </div>
    </div>
  </section>

  <section class="section wrap me" id="about-me">
    <div class="me-photo">
      <img src="/images/eileen.jpg" alt="Eileen Yeoh holding her Student Excellence Award at Universiti Teknologi PETRONAS" width="560" height="560" />
    </div>
    <div class="me-text">
      <h2>I like building systems end to end, and explaining them so other people can build on them.</h2>
      <p class="me-lede">
        My work so far spans semiconductor fabrication, power electronics,
        embedded IoT and applied AI, usually as part of a team racing a
        deadline. Outside the lab I run events and write for the engineering
        societies at UTP, and this year I'm studying in Sheffield.
      </p>
      <div class="me-lists">
        <div>
          <h3>Right now</h3>
          <ul class="role-list">
            {now.map((n) => (
              <li><strong>{n.role}</strong><span>{n.org}</span></li>
            ))}
          </ul>
        </div>
        <div>
          <h3>Recognition</h3>
          <ul class="role-list">
            {recognition.map((r) => (
              <li>
                {r.href ? <a href={r.href}><strong>{r.what}</strong></a> : <strong>{r.what}</strong>}
                <span>{r.where}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section wrap work" id="work">
    <div class="work-head">
      <h2>Selected work</h2>
      <p class="muted">Six projects, each with its own page you can explore.</p>
    </div>
    <WorkList />
  </section>

  {posts.length > 0 && (
    <section class="section wrap writing">
      <h2>Writing</h2>
      <div class="post-list">
        {posts.map((post) => (
          <a class="post-row" href={`/blog/${post.id}`}>
            <span class="muted post-date">{fmt.format(post.data.date)}</span>
            <span class="post-title">{post.data.title}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="contact">
    <div class="wrap contact-inner">
      <h2>Working on something in hardware, chips or applied AI? I'd like to hear about it.</h2>
      <div class="contact-actions">
        <a class="btn btn--trace" href="mailto:eileenyeoh06@gmail.com">Email me</a>
        <a class="btn btn--glass" href={LINKEDIN} target="_blank" rel="noopener">LinkedIn</a>
        <a class="btn btn--glass" href="https://github.com/EileenYJH" target="_blank" rel="noopener">GitHub</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Hero: me, over a moving wall of photos ---------- */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    color: #fff;
    overflow: hidden;
    isolation: isolate;
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(21, 26, 46, 0.94) 0%, rgba(21, 26, 46, 0.8) 42%, rgba(21, 26, 46, 0.35) 100%),
      linear-gradient(0deg, rgba(21, 26, 46, 0.85) 0%, transparent 45%);
  }
  .hero-inner { position: relative; padding-block: 8rem clamp(3rem, 9vh, 6rem); }
  .hero-hello { font-size: clamp(1.1rem, 2vw, 1.4rem); font-weight: 500; color: var(--trace); }
  .hero-name {
    font-size: clamp(3.6rem, 12.5vw, 10.5rem);
    font-weight: 750;
    font-variation-settings: 'wdth' 85;
    line-height: 0.9;
    letter-spacing: -0.045em;
    margin-top: 0.3rem;
  }
  .hero-trace {
    display: block;
    width: min(560px, 80%);
    height: 34px;
    margin: 1.2rem 0 1.4rem;
    overflow: visible;
  }
  .hero-trace path {
    fill: none;
    stroke: var(--trace);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1000;
    stroke-dashoffset: 1000;
    animation: trace-draw 2.4s cubic-bezier(0.45, 0, 0.2, 1) 0.3s forwards;
  }
  @keyframes trace-draw { to { stroke-dashoffset: 0; } }
  .hero-lede { font-size: clamp(1.15rem, 1.8vw, 1.45rem); line-height: 1.5; max-width: 40ch; color: #EEF1F7; }
  .hero-where { margin-top: 1rem; font-size: 0.98rem; color: rgba(255, 255, 255, 0.72); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 2rem; }

  .btn--trace { background: var(--trace); border-color: var(--trace); color: var(--ink); font-weight: 650; }
  .btn--trace:hover { box-shadow: 0 10px 28px rgba(242, 193, 78, 0.35); }
  .btn--glass { background: rgba(255, 255, 255, 0.08); border-color: rgba(255, 255, 255, 0.55); color: #fff; }
  .btn--glass:hover { background: #fff; color: var(--ink); }

  /* ---------- About me ---------- */
  .me {
    display: grid;
    grid-template-columns: minmax(220px, 0.8fr) 1.6fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  .me-photo img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 35%;
    border-radius: 18px;
    box-shadow: 0 30px 60px -30px rgba(21, 26, 46, 0.45);
  }
  .me-photo { position: sticky; top: 6rem; }
  .me-text h2 { font-size: clamp(1.8rem, 3.4vw, 2.7rem); max-width: 22ch; }
  .me-lede { font-size: 1.15rem; margin-top: 1.3rem; max-width: 56ch; }
  .me-lists { display: grid; grid-template-columns: 1fr 1fr; gap: 2.5rem; margin-top: 2.8rem; }
  .me-lists h3 { font-size: 1rem; font-weight: 650; color: var(--accent); letter-spacing: 0; }
  .role-list { list-style: none; padding: 0; margin-top: 0.8rem; border-top: 1px solid var(--line); }
  .role-list li { padding: 0.8rem 0; border-bottom: 1px solid var(--line); display: grid; gap: 0.1rem; }
  .role-list strong { font-weight: 620; }
  .role-list a { text-decoration-color: var(--line); text-underline-offset: 3px; }
  .role-list a:hover { color: var(--accent); text-decoration-color: currentColor; }
  .role-list span { font-size: 0.92rem; color: var(--muted); }

  /* ---------- Selected work ---------- */
  .work-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; flex-wrap: wrap; }
  /* ---------- Writing ---------- */
  .post-list { margin-top: 1.5rem; border-top: 1px solid var(--line); }
  .post-row {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1.5rem;
    align-items: baseline;
    padding: 1.2rem 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .post-row:hover .post-title { color: var(--accent); }
  .post-title { font-size: 1.2rem; font-weight: 600; transition: color 0.2s ease; }
  .post-date { font-size: 0.88rem; }

  /* ---------- Contact ---------- */
  .contact { background: var(--ink); color: #fff; padding-block: clamp(4rem, 10vh, 7rem); margin-top: var(--space-section); }
  .contact h2 { font-size: clamp(1.8rem, 3.6vw, 2.9rem); max-width: 24ch; }
  .contact-actions { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 2rem; }
  /* The footer follows the dark band directly. */
  :global(footer.footer.footer) { margin-top: 0; }

  @media (max-width: 900px) {
    .me { grid-template-columns: 1fr; }
    .me-photo { position: static; max-width: 320px; }

  }
  @media (max-width: 600px) {
    .me-lists { grid-template-columns: 1fr; gap: 2rem; }
    .hero-shade {
      background: linear-gradient(0deg, rgba(21, 26, 46, 0.96) 15%, rgba(21, 26, 46, 0.6) 100%);
    }
    .post-row { grid-template-columns: 1fr; gap: 0.2rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-trace path { animation: none; stroke-dashoffset: 0; }
  }
</style>
