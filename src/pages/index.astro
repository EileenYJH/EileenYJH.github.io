---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoWall from '../components/home/PhotoWall.astro';
import WorkList from '../components/home/WorkList.astro';
import Timeline from '../components/home/Timeline.astro';
import Highlights from '../components/home/Highlights.astro';
import Leadership from '../components/home/Leadership.astro';

const LINKEDIN = 'https://www.linkedin.com/in/eileen-yeoh-jing-han-7ba86a214/';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const fmt = new Intl.DateTimeFormat('en', { day: 'numeric', month: 'short', year: 'numeric' });

import Chapter from '../components/home/Chapter.astro';
---
<BaseLayout
  overlayNav
  title="Eileen Yeoh | Electrical & electronic engineering"
  description="Eileen Yeoh is an electrical and electronic engineering student at UTP, currently on student exchange at the University of Sheffield. Projects across semiconductor fabrication, power electronics, embedded IoT and applied AI."
>
  <section class="hero" id="top" data-dot="Hello">
    <PhotoWall />
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <p class="hero-hello">Hello, I'm</p>
      <h1 class="hero-name">Eileen</h1>
      <svg class="hero-trace" viewBox="0 0 600 40" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 20 C 15 -6, 30 -6, 45 20 S 75 46, 90 20 S 118 2, 132 20 S 156 34, 168 20 S 188 10, 198 20 S 214 27, 224 20 S 240 15, 250 20 S 262 23, 272 20 L 600 20" />
      </svg>
      <p class="hero-lede">
        Electrical and electronic engineering student.<br />I build across the
        stack: from a transistor fabricated by hand in a cleanroom to AI that
        picks jammers out of raw radio.
      </p>
      <p class="hero-where">
        Bachelor of Electrical and Electronics Engineering with Honours<br />
        Universiti Teknologi PETRONAS (UTP), Malaysia
      </p>
      <div class="hero-actions">
        <a class="btn btn--trace" href="#work">See my projects</a>
        <a class="btn btn--glass" href={LINKEDIN} target="_blank" rel="noopener">Connect on LinkedIn</a>
      </div>
    </div>
  </section>

  <section class="section wrap me" id="about-me" data-sec data-dot="About me">
    <div class="me-photo" id="me-photo">
      <span class="me-dots" aria-hidden="true"></span>
      <span class="me-frame" aria-hidden="true"></span>
      <img src="/images/eileen-award.jpg" alt="Eileen Yeoh holding her foundation certificate and Student Excellence Award at Universiti Teknologi PETRONAS" width="800" height="800" />
    </div>
    <div class="me-text">
      <Chapter num="01" label="About me" />
      <h2>I love exploring new ideas, building them into real things, and explaining them so others can build on them too.</h2>
      <p class="me-lede">
        My work so far spans semiconductor fabrication, power electronics,
        embedded IoT and applied AI, usually as part of a team racing a
        deadline. Outside the lab I run events and write for the engineering
        societies at UTP, and this semester I'm on exchange at the University of Sheffield.
      </p>
    </div>
  </section>

  <section class="section wrap journey" id="journey" data-sec data-dot="Studies">
    <Chapter num="02" label="Studies" />
    <h2>Academic journey</h2>
    <Timeline />
  </section>

  <section class="highlights" id="highlights" data-sec data-dot="Beyond class">
    <div class="hl-stick">
      <div class="wrap">
        <Chapter num="03" label="Beyond class" />
        <h2>Awards, competitions and events</h2>
      </div>
      <Highlights />
      <div class="wrap hl-progress" aria-hidden="true"><i></i></div>
    </div>
  </section>

  <section class="section wrap leadership" id="leadership" data-sec data-dot="Leadership">
    <Chapter num="04" label="Leadership" />
    <h2>Leading and organising</h2>
    <Leadership />
  </section>

  <section class="section wrap work" id="work" data-sec data-dot="Projects">
    <Chapter num="05" label="Projects" />
    <div class="work-head">
      <h2>Selected work</h2>
      <p class="muted">Six projects, each with its own page you can explore.</p>
    </div>
    <WorkList />
  </section>

  {posts.length > 0 && (
    <section class="section wrap writing" id="writing" data-sec data-dot="Blog">
      <Chapter num="06" label="Blog" />
      <h2>Writing</h2>
      <div class="post-list">
        {posts.map((post) => (
          <a class="post-row" href={`/blog/${post.id}`} data-rise>
            <span class="muted post-date">{fmt.format(post.data.date)}</span>
            <span class="post-title">{post.data.title}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="contact" id="contact" data-dot="Contact">
    <span class="contact-glow" aria-hidden="true"></span>
    <div class="wrap contact-inner">
      <h2>Working on something in hardware, chips or applied AI? I'd like to hear about it.</h2>
      <div class="contact-actions">
        <a class="btn btn--trace" href="mailto:eileenyeoh06@gmail.com">Email me</a>
        <a class="btn btn--glass" href={LINKEDIN} target="_blank" rel="noopener">LinkedIn</a>
        <a class="btn btn--glass" href="https://github.com/EileenYJH" target="_blank" rel="noopener">GitHub</a>
      </div>
    </div>
  </section>
  <nav class="dots" aria-label="Sections"></nav>

  <script>
    // Home scroll effects: hero parallax, staggered rises, contact glow and the side section dots.
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const root = document.documentElement;
    if (!still) {
      root.classList.add('rise-on');
      const io = new IntersectionObserver((es) => es.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('is-up'); io.unobserve(e.target); }
      }), { rootMargin: '0px 0px -10% 0px' });
      document.querySelectorAll('[data-rise]').forEach((el) => io.observe(el));
    }
    const hero = document.querySelector<HTMLElement>('.hero');
    const contact = document.querySelector<HTMLElement>('.contact');
    const sections = [...document.querySelectorAll<HTMLElement>('[data-dot]')];
    const dots = document.querySelector<HTMLElement>('.dots');
    if (dots) {
      sections.forEach((s) => {
        const a = document.createElement('a');
        a.href = `#${s.id}`;
        a.innerHTML = `<span>${s.dataset.dot}</span>`;
        dots.append(a);
      });
    }
    let hraf = 0;
    const onScroll = () => {
      hraf = 0;
      const vh = innerHeight;
      if (!still && hero) hero.style.setProperty('--hp', Math.min(1, scrollY / vh).toFixed(3));
      if (!still && contact) {
        const r = contact.getBoundingClientRect();
        contact.style.setProperty('--cpx', Math.max(0, Math.min(1, (vh - r.top) / (vh + r.height))).toFixed(3));
      }
      let current = 0;
      sections.forEach((s, i) => { if (s.getBoundingClientRect().top < vh * 0.45) current = i; });
      dots?.querySelectorAll('a').forEach((a, i) => a.classList.toggle('on', i === current));
      dots?.classList.toggle('show', scrollY > vh * 0.6);
    };
    addEventListener('scroll', () => { if (!hraf) hraf = requestAnimationFrame(onScroll); }, { passive: true });
    onScroll();

    // Section entrances: each section's marker line draws as it scrolls in,
    // then its number, label and heading rise into place.
    const secs = [...document.querySelectorAll<HTMLElement>('[data-sec]')];
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      secs.forEach((s) => s.classList.add('sec-anim'));
      let raf = 0;
      const tick = () => {
        raf = 0;
        secs.forEach((s) => {
          const top = s.getBoundingClientRect().top;
          const p = Math.max(0, Math.min(1, (innerHeight - top) / (innerHeight * 0.6)));
          s.style.setProperty('--cp', p.toFixed(3));
          if (p > 0.15) s.classList.add('sec-in');
        });
      };
      addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(tick); }, { passive: true });
      addEventListener('resize', tick);
      tick();
    }

    // Photo backdrop follows the mouse and the scroll position.
    const photo = document.getElementById('me-photo');
    if (photo && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const clamp = (v: number) => Math.max(-1, Math.min(1, v));
      let frame = 0;
      const onScroll = () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => {
          const r = photo.getBoundingClientRect();
          const centre = r.top + r.height / 2;
          photo.style.setProperty('--sp', clamp((centre - innerHeight / 2) / innerHeight).toFixed(3));
        });
      };
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();
      if (matchMedia('(hover: hover)').matches) {
        const section = document.getElementById('about-me');
        section?.addEventListener('pointermove', (e) => {
          const r = photo.getBoundingClientRect();
          photo.style.setProperty('--mx', clamp((e.clientX - (r.left + r.width / 2)) / (r.width * 1.2)).toFixed(3));
          photo.style.setProperty('--my', clamp((e.clientY - (r.top + r.height / 2)) / (r.height * 1.2)).toFixed(3));
        });
        section?.addEventListener('pointerleave', () => {
          photo.style.setProperty('--mx', '0');
          photo.style.setProperty('--my', '0');
        });
      }
    }
  </script>
</BaseLayout>

<style>
  /* ---------- Home sizing: a little smaller so each section fits a screen ---------- */
  :global(html) { font-size: 93.75%; scroll-snap-type: y proximity; }
  :global(:root) { --space-section: clamp(3.5rem, 9vh, 6rem); }
  .hero, .me, .journey, .leadership, .work, .writing, .contact { scroll-snap-align: start; scroll-margin-top: 64px; }
  .highlights { scroll-margin-top: 0; }
  .hero { scroll-margin-top: 0; }

  /* ---------- Scroll effects ---------- */
  .hero :global(.wall) { transform: scale(calc(1 + var(--hp, 0) * 0.12)); filter: blur(calc(var(--hp, 0) * 4px)); transform-origin: 30% 60%; }
  .hero-inner { transform: translateY(calc(var(--hp, 0) * -90px)); opacity: calc(1 - var(--hp, 0) * 1.3); }
  :global(.rise-on [data-rise]) {
    opacity: 0;
    translate: 0 40px;
    scale: 0.96;
    rotate: -0.8deg;
    transition: opacity 0.6s ease calc(var(--i, 0) * 90ms), translate 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) calc(var(--i, 0) * 90ms), scale 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) calc(var(--i, 0) * 90ms), rotate 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) calc(var(--i, 0) * 90ms);
  }
  :global(.rise-on [data-rise-x]) { translate: -60px 0; rotate: 0deg; scale: 1; }
  :global(.rise-on [data-rise].is-up) { opacity: 1; translate: 0 0; scale: 1; rotate: 0deg; }

  /* Side dots: where you are on the page. */
  .dots {
    position: fixed; right: 1.1rem; top: 50%; translate: 12px -50%; z-index: 40;
    display: grid; gap: 0.75rem;
    opacity: 0; pointer-events: none;
    transition: opacity 0.4s ease, translate 0.4s ease;
  }
  .dots:global(.show) { opacity: 1; translate: 0 -50%; pointer-events: auto; }
  .dots :global(a) {
    position: relative; display: block; width: 10px; height: 10px; border-radius: 50%;
    border: 2px solid var(--accent); background: var(--paper);
    transition: transform 0.25s ease, background 0.25s ease;
  }
  .dots :global(a.on) { background: var(--accent); transform: scale(1.35); }
  .dots :global(a span) {
    position: absolute; right: 18px; top: 50%; translate: 0 -50%;
    white-space: nowrap; font-size: 0.75rem; font-weight: 650; color: var(--ink);
    background: var(--paper-raised); border: 1px solid var(--line); border-radius: 999px; padding: 0.2rem 0.6rem;
    opacity: 0; transition: opacity 0.2s ease;
    pointer-events: none;
  }
  .dots :global(a:hover span) { opacity: 1; }
  @media (max-width: 1100px) { .dots { display: none; } }

  /* Contact: a glow that travels across the band as you scroll. */
  .contact { position: relative; overflow: hidden; isolation: isolate; }
  .contact-glow {
    position: absolute; z-index: -1; width: 60vw; height: 60vw; border-radius: 50%;
    left: calc(-20vw + var(--cpx, 0.5) * 70vw); top: -20vw;
    background: radial-gradient(circle, rgba(var(--accent-rgb), 0.55), transparent 62%);
    filter: blur(10px);
  }
  .contact h2 { transform: scale(calc(0.94 + var(--cpx, 1) * 0.06)); transform-origin: left center; }

  /* ---------- Hero: me, over a moving wall of photos ---------- */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    color: #fff;
    overflow: hidden;
    isolation: isolate;
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(21, 26, 46, 0.75) 0%, transparent 14%),
      linear-gradient(90deg, rgba(21, 26, 46, 0.88) 0%, rgba(21, 26, 46, 0.7) 40%, rgba(21, 26, 46, 0.12) 72%, transparent 100%),
      linear-gradient(0deg, rgba(21, 26, 46, 0.75) 0%, transparent 42%);
  }
  .hero-inner { text-shadow: 0 2px 18px rgba(21, 26, 46, 0.55); }
  .hero-inner { position: relative; padding-block: 8rem clamp(3rem, 9vh, 6rem); }
  .hero-hello { font-size: clamp(1.1rem, 2vw, 1.4rem); font-weight: 500; color: var(--trace); }
  .hero-name {
    font-size: clamp(3.6rem, 12.5vw, 10.5rem);
    font-weight: 750;
    font-variation-settings: 'wdth' 85;
    line-height: 0.9;
    letter-spacing: -0.045em;
    margin-top: 0.3rem;
  }
  .hero-trace {
    display: block;
    width: min(560px, 80%);
    height: 34px;
    margin: 1.2rem 0 1.4rem;
    overflow: visible;
  }
  .hero-trace path {
    fill: none;
    stroke: var(--trace);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1000;
    stroke-dashoffset: 1000;
    animation: trace-draw 2.4s cubic-bezier(0.45, 0, 0.2, 1) 0.3s forwards;
  }
  @keyframes trace-draw { to { stroke-dashoffset: 0; } }
  .hero-lede { font-size: clamp(1.15rem, 1.8vw, 1.45rem); line-height: 1.5; max-width: none; color: #EEF1F7; }
  .hero-where { margin-top: 1rem; font-size: 0.98rem; line-height: 1.6; max-width: none; color: rgba(255, 255, 255, 0.8); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 2rem; }

  .btn--trace { background: var(--trace); border-color: var(--trace); color: var(--ink); font-weight: 650; }
  .btn--trace:hover { box-shadow: 0 10px 28px rgba(242, 193, 78, 0.35); }
  .btn--glass { background: rgba(255, 255, 255, 0.08); border-color: rgba(255, 255, 255, 0.55); color: #fff; }
  .btn--glass:hover { background: #fff; color: var(--ink); }

  /* ---------- About me ---------- */
  .me {
    display: grid;
    grid-template-columns: minmax(260px, 1fr) 1.4fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  /* Photo with a perfboard dot pad and a trace-yellow frame behind it.
     --mx/--my follow the mouse (-1..1), --sp follows scroll (-1..1). */
  .me-photo {
    --mx: 0;
    --my: 0;
    --sp: 0;
    perspective: 900px;
    isolation: isolate;
  }
  .me-dots, .me-frame {
    position: absolute;
    inset: 0;
    border-radius: 22px;
    z-index: -1;
    transition: transform 0.25s ease-out;
    will-change: transform;
  }
  .me-dots {
    background-image: radial-gradient(circle, rgba(var(--accent-rgb), 0.45) 1.6px, transparent 2px);
    background-size: 16px 16px;
    transform: translate(calc(-26px - var(--mx) * 22px), calc(-26px - var(--my) * 22px + var(--sp) * 36px));
  }
  .me-frame {
    border: 2.5px solid var(--trace);
    transform: translate(calc(22px + var(--mx) * 14px), calc(22px + var(--my) * 14px - var(--sp) * 28px)) rotate(calc(var(--mx) * 1.5deg));
  }
  .me-photo img {
    position: relative;
    width: 100%;
    height: auto;
    border-radius: 18px;
    transform: rotateY(calc(var(--mx) * 7deg)) rotateX(calc(var(--my) * -7deg));
    transition: transform 0.25s ease-out;
    box-shadow: 0 30px 60px -30px rgba(21, 26, 46, 0.45);
  }
  .me-photo { position: sticky; top: 6rem; }
  @media (prefers-reduced-motion: reduce) {
    .me-photo { --mx: 0 !important; --my: 0 !important; --sp: 0 !important; }
  }
  .me-text h2 { font-size: clamp(1.8rem, 3.4vw, 2.7rem); max-width: none; }
  .me-lede { font-size: 1.15rem; margin-top: 1.3rem; max-width: none; }

  /* ---------- Journey ---------- */
  .journey { padding-top: 0; }
  .journey > h2 { text-align: center; }
  .highlights { position: relative; padding-block: calc(var(--space-section) * 0.5); }
  .highlights h2 { margin-bottom: 1.4rem; }
  .highlights:global(.hl-pinned) { padding-block: 0; }
  .highlights:global(.hl-pinned) .hl-stick {
    position: sticky; top: 64px; height: calc(100vh - 64px);
    display: flex; flex-direction: column; justify-content: center; overflow: hidden;
  }
  .hl-progress { height: 3px; background: var(--line); border-radius: 3px; overflow: hidden; display: none; }
  .highlights:global(.hl-pinned) .hl-progress { display: block; }
  .hl-progress i { display: block; height: 100%; background: linear-gradient(90deg, var(--accent), var(--trace)); transform: scaleX(var(--hlp, 0)); transform-origin: left; }
  .journey-lede { margin-top: 0.6rem; max-width: none; }

  /* ---------- Selected work ---------- */
  .work-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; flex-wrap: wrap; }
  /* ---------- Writing ---------- */
  .post-list { margin-top: 1.5rem; border-top: 1px solid var(--line); }
  .post-row {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1.5rem;
    align-items: baseline;
    padding: 1.2rem 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .post-row:hover .post-title { color: var(--accent); }
  .post-title { font-size: 1.2rem; font-weight: 600; transition: color 0.2s ease; }
  .post-date { font-size: 0.88rem; }

  /* ---------- Section entrances ---------- */
  :global(.sec-anim) > h2, :global(.sec-anim) .me-text > h2, :global(.sec-anim) .work-head > h2 {
    transition: opacity 0.7s ease 0.15s, transform 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) 0.15s, clip-path 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) 0.15s;
  }
  :global(.sec-anim:not(.sec-in)) > h2, :global(.sec-anim:not(.sec-in)) .me-text > h2, :global(.sec-anim:not(.sec-in)) .work-head > h2 {
    opacity: 0; transform: translateY(28px); clip-path: inset(0 0 100% 0);
  }
  :global(.sec-anim.sec-in) > h2, :global(.sec-anim.sec-in) .me-text > h2, :global(.sec-anim.sec-in) .work-head > h2 { clip-path: inset(0 0 -10% 0); }

  /* ---------- Contact ---------- */
  .contact { background: var(--ink); color: #fff; padding-block: clamp(4rem, 10vh, 7rem); margin-top: var(--space-section); }
  .contact h2 { font-size: clamp(1.8rem, 3.6vw, 2.9rem); max-width: none; text-wrap: wrap; }
  .contact-actions { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 2rem; }
  @media (min-width: 900px) {
    .contact-inner { display: flex; align-items: flex-end; justify-content: space-between; gap: 3rem; }
    .contact h2 { flex: 1; }
    .contact-actions { margin-top: 0; flex-wrap: nowrap; flex-shrink: 0; }
  }
  /* The footer follows the dark band directly. */
  :global(footer.footer.footer) { margin-top: 0; }

  @media (max-width: 900px) {
    .me { grid-template-columns: 1fr; }
    .me-photo { position: static; max-width: 480px; }

  }
  @media (max-width: 600px) {
    .hero-shade {
      background: linear-gradient(0deg, rgba(21, 26, 46, 0.95) 12%, rgba(21, 26, 46, 0.72) 55%, rgba(21, 26, 46, 0.35) 100%);
    }
    .post-row { grid-template-columns: 1fr; gap: 0.2rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-trace path { animation: none; stroke-dashoffset: 0; }
  }
</style>
