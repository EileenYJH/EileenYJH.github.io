---
// The T-shaped floor plan from the live ARIA dashboard.
const rooms = [
  { n: 'N1', z: 'A', x: 76, y: 30, w: 150, h: 84 },
  { n: 'N2', z: 'B', x: 232, y: 30, w: 150, h: 84 },
  { n: 'N3', z: 'B', x: 388, y: 30, w: 150, h: 84 },
  { n: 'N4', z: 'C', x: 544, y: 30, w: 150, h: 84 },
  { n: 'N5', z: 'A', x: 150, y: 176, w: 96, h: 64 },
  { n: 'N6', z: 'C', x: 514, y: 176, w: 96, h: 64 },
];
---
<div class="evac card" data-reveal>
  <div class="evac-map">
    <svg viewBox="0 0 760 300" role="img" aria-label="T-shaped floor plan from the ARIA dashboard: six nodes in zones A, B and C along one corridor, with Exit A on the left, Exit C on the right and Exit B down the middle. Click a room to start a fire in its zone and see the routing change.">
      <!-- corridor: the T -->
      <rect x="64" y="122" width="632" height="40" fill="#E2E8F0" />
      <rect x="360" y="162" width="40" height="76" fill="#E2E8F0" />
      <!-- escape routes are drawn here by the script -->
      <defs><marker id="evac-head" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="4" markerHeight="4" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="context-stroke" /></marker></defs>
      <g id="evac-routes"></g>
      <!-- exits -->
      <g class="exit"><rect x="6" y="116" width="58" height="52" rx="8" fill="#E3F0E8" stroke="#2E7D4F" stroke-width="1.5" id="exit-A" />
        <text x="35" y="138" text-anchor="middle" class="ex-t">Exit A</text><text x="35" y="154" text-anchor="middle" class="ex-s" id="exit-s-A">OPEN</text></g>
      <g class="exit"><rect x="696" y="116" width="58" height="52" rx="8" fill="#E3F0E8" stroke="#2E7D4F" stroke-width="1.5" id="exit-C" />
        <text x="725" y="138" text-anchor="middle" class="ex-t">Exit C</text><text x="725" y="154" text-anchor="middle" class="ex-s" id="exit-s-C">OPEN</text></g>
      <g class="exit"><rect x="344" y="238" width="72" height="50" rx="8" fill="#E3F0E8" stroke="#2E7D4F" stroke-width="1.5" id="exit-B" />
        <text x="380" y="259" text-anchor="middle" class="ex-t">Exit B</text><text x="380" y="275" text-anchor="middle" class="ex-s" id="exit-s-B">OPEN</text></g>
      <!-- rooms: N1 to N4 above the corridor, N5 and N6 below -->
      {rooms.map((r) => (
        <g class="zone" data-zone={r.z} style="cursor: pointer;">
          <rect x={r.x} y={r.y} width={r.w} height={r.h} rx="8" fill="#FFFFFF" stroke="#DDE3EC" stroke-width="1.6" class={`zr zr-${r.z}`} />
          <text x={r.x + r.w / 2} y={r.y + (r.h > 70 ? 32 : 26)} text-anchor="middle" class="rm-n">{r.n}</text>
          <text x={r.x + r.w / 2} y={r.y + (r.h > 70 ? 50 : 42)} text-anchor="middle" class="rm-z">Zone {r.z}</text>
          <text x={r.x + r.w / 2} y={r.y + (r.h > 70 ? 70 : 56)} text-anchor="middle" font-size="16" class={`fire fire-${r.z}`}></text>
        </g>
      ))}
    </svg>
    <p class="evac-hint muted">Click any room to start a fire in its zone. Click again to put it out.</p>
    <ul class="evac-routes" id="evac-route-text"></ul>
  </div>
  <div class="evac-side">
    <p class="evac-title">Exit congestion</p>
    {(['A', 'B', 'C'] as const).map((z) => (
      <label class="evac-check"><input type="checkbox" data-congest={z} /> Exit {z} congested</label>
    ))}
    <button type="button" id="evac-reset" class="evac-reset">Reset</button>
    <ul class="evac-legend muted">
      <li><span style="background: #2E7D4F;"></span> safe: follow arrows</li>
      <li><span style="background: #C03028;"></span> fire: routing away</li>
      <li><span style="background: #D98E1B;"></span> exit congested: re-routed</li>
    </ul>
  </div>
</div>

<style>
  .evac { display: grid; grid-template-columns: 2.2fr 1fr; gap: 1.5rem; padding: 1.5rem; align-items: center; }
  .evac-map svg { width: 100%; height: auto; font-family: var(--font-body); }
  .evac-map :global(.rm-n) { font-size: 17px; font-weight: 700; fill: #151A2E; }
  .evac-map :global(.rm-z) { font-size: 11px; fill: #5A6272; }
  .evac-map :global(.ex-t) { font-size: 11px; font-weight: 700; fill: #151A2E; }
  .evac-map :global(.ex-s) { font-size: 9px; font-weight: 600; fill: #5A6272; letter-spacing: 0.04em; }
  .evac-map .zone:hover rect { stroke-width: 2.6; }
  .evac-hint { font-size: 0.8rem; margin-top: 0.4rem; }
  .evac-routes { list-style: none; padding: 0; margin-top: 0.6rem; display: grid; gap: 0.3rem; font-size: 0.85rem; }
  .evac-routes :global(li) { padding: 0.35rem 0.7rem; border: 1px solid var(--line); border-radius: 8px; background: #fff; }
  .evac-map :global(.route) { fill: none; stroke-width: 5; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 2 14; animation: evac-flow 0.9s linear infinite; }
  @keyframes evac-flow { to { stroke-dashoffset: -16; } }
  @media (prefers-reduced-motion: reduce) { .evac-map :global(.route) { animation: none; stroke-dasharray: none; stroke-width: 3; opacity: 0.8; } }
  .evac-title { font-weight: 600; font-size: 0.9rem; }
  .evac-check { display: flex; gap: 0.45rem; align-items: center; font-size: 0.9rem; margin-top: 0.5rem; }
  .evac-check input { accent-color: var(--accent); }
  .evac-reset {
    margin-top: 1rem;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 550;
    padding: 0.45rem 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--paper);
    cursor: pointer;
  }
  .evac-reset:hover { border-color: var(--accent); }
  .evac-legend { list-style: none; padding: 0; margin-top: 1.4rem; font-size: 0.8rem; display: grid; gap: 0.4rem; }
  .evac-legend span { display: inline-block; width: 12px; height: 12px; border-radius: 3px; margin-right: 0.4rem; vertical-align: -1px; }
  @media (max-width: 800px) { .evac { grid-template-columns: 1fr; } }
</style>

<script>
  import { routeZones, type ZoneId } from '../../lib/evac-routing';

  const fire = new Set<ZoneId>();
  const congested = new Set<ZoneId>();
  const ZONES: ZoneId[] = ['A', 'B', 'C'];

  const FILL: Record<string, string> = {
    off: '#FFFFFF',
    green: '#E3F0E8',
    red: '#F7E2E0',
    orange: '#F9EDDA',
  };
  const STROKE: Record<string, string> = {
    off: '#DDE3EC',
    green: '#2E7D4F',
    red: '#C03028',
    orange: '#D98E1B',
  };

  // Where each zone is sent, following the hub firmware: a safe zone uses its own exit;
  // a zone on fire is sent the other way, to the nearest exit whose zone is not burning.
  const Y = { A: 136, B: 142, C: 148 } as const;
  const START: Record<ZoneId, number[]> = { A: [151], B: [310, 466], C: [619] };
  const EXIT_X: Record<string, number> = { A: 64, C: 696 };
  function target(z: ZoneId): ZoneId {
    const all = fire.has('A') && fire.has('B') && fire.has('C');
    if (!fire.has(z) || all) return z;
    if (z === 'A') return !fire.has('B') ? 'B' : 'C';
    if (z === 'B') return !fire.has('A') ? 'A' : 'C';
    return !fire.has('B') ? 'B' : 'A';
  }
  function pathFor(z: ZoneId, x0: number, to: ZoneId): string {
    const y = Y[z];
    if (to === 'B') return `M${x0},${y} L380,${y} L380,236`;
    return `M${x0},${y} L${EXIT_X[to]},${y}`;
  }
  const NS = 'http://www.w3.org/2000/svg';
  function render() {
    const plan = routeZones(fire, congested);
    const g = document.getElementById('evac-routes');
    const list = document.getElementById('evac-route-text');
    if (g) g.textContent = '';
    if (list) list.textContent = '';
    for (const z of ZONES) {
      const route = plan[z];
      document.querySelectorAll<SVGRectElement>(`.zr-${z}`).forEach((rect) => {
        rect.setAttribute('fill', FILL[route.color]);
        rect.setAttribute('stroke', STROKE[route.color]);
      });
      document.querySelectorAll<SVGTextElement>(`.fire-${z}`).forEach((t) => (t.textContent = fire.has(z) ? '🔥' : ''));
      const to = target(z);
      const colour = fire.has(z) ? STROKE.red : congested.has(to) ? STROKE.orange : STROKE.green;
      for (const x0 of START[z]) {
        const path = document.createElementNS(NS, 'path');
        path.setAttribute('d', pathFor(z, x0, to));
        path.setAttribute('class', 'route');
        path.setAttribute('marker-end', 'url(#evac-head)');
        path.setAttribute('stroke', colour);
        g?.appendChild(path);
      }
      if (list) {
        const li = document.createElement('li');
        const b = document.createElement('b');
        b.textContent = `Zone ${z}: `;
        li.append(b, fire.has(z) && to !== z ? `fire, move away to Exit ${to}` : fire.has(z) ? `fire, try Exit ${to}` : `proceed to Exit ${to}`);
        if (congested.has(to)) { const c = document.createElement('span'); c.textContent = ' (congested)'; c.style.color = STROKE.orange; li.append(c); }
        list.appendChild(li);
      }
      const exit = document.getElementById(`exit-${z}`);
      const label = document.getElementById(`exit-s-${z}`);
      const busy = congested.has(z);
      exit?.setAttribute('fill', busy ? '#F9EDDA' : '#E3F0E8');
      exit?.setAttribute('stroke', busy ? '#D98E1B' : '#2E7D4F');
      if (label) label.textContent = busy ? 'CONGESTED' : 'OPEN';
    }
  }

  document.querySelectorAll<SVGGElement>('.zone').forEach((g) => {
    g.addEventListener('click', () => {
      const z = g.dataset.zone as ZoneId;
      if (fire.has(z)) fire.delete(z);
      else fire.add(z);
      render();
    });
  });

  document.querySelectorAll<HTMLInputElement>('[data-congest]').forEach((cb) => {
    cb.addEventListener('change', () => {
      const z = cb.dataset.congest as ZoneId;
      if (cb.checked) congested.add(z);
      else congested.delete(z);
      render();
    });
  });

  document.getElementById('evac-reset')?.addEventListener('click', () => {
    fire.clear();
    congested.clear();
    document.querySelectorAll<HTMLInputElement>('[data-congest]').forEach((cb) => (cb.checked = false));
    render();
  });

  render();
</script>
