---
// Interactive 3D model of the Hydro-Magnetic prototype. Three.js scene that
// loops the seven process steps: fill, dose, stir and floc, drain onto the
// Pelton turbine, charge the battery, catch flocs on the magnetic drum,
// scrape them into the bin while clean water runs to the river.
const steps = [
  'Wastewater enters the coagulation tank',
  'Fe₃O₄@C-IM-C₁₆ nanoparticles are added',
  'Stirrer mixes for 30 to 60 minutes, flocs form',
  'Outlet opens, water falls onto the Pelton turbine',
  'Turbine spins the generator and charges the battery',
  'Rotary magnetic drum catches the magnetic flocs',
  'Scraper drops flocs in the bin, clean water exits',
];
---
<div class="hm3d" data-hm3d>
  <div class="hm3d-stage">
    <canvas class="hm3d-canvas" aria-label="Animated 3D model of the Hydro-Magnetic prototype"></canvas>
    <span class="hm3d-tag" data-anchor="tank">Coagulation tank</span>
    <span class="hm3d-tag" data-anchor="turbine">Pelton turbine + generator</span>
    <span class="hm3d-tag" data-anchor="battery">Battery</span>
    <span class="hm3d-tag" data-anchor="drum">Rotary magnetic drum</span>
    <span class="hm3d-tag" data-anchor="bin">Collection bin</span>
    <div class="hm3d-hud">
      <div class="hm3d-meter"><span>Battery</span><b data-battery>40%</b><i><em data-battery-bar></em></i></div>
      <div class="hm3d-meter"><span>Turbine</span><b data-rpm>0 rpm</b></div>
      <div class="hm3d-meter"><span>Flocs captured</span><b data-flocs>0</b></div>
    </div>
    <p class="hm3d-hint">Drag to rotate · scroll the page as normal</p>
  </div>
  <div class="hm3d-bar">
    <button type="button" class="hm3d-play" data-play aria-label="Pause">❚❚</button>
    <ol class="hm3d-steps">
      {steps.map((s, i) => <li><button type="button" data-step={i}><span>{String(i + 1).padStart(2, '0')}</span>{s}</button></li>)}
    </ol>
  </div>
</div>

<script>
  import * as THREE from 'three';
  import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';

  const root = document.querySelector<HTMLElement>('[data-hm3d]');
  if (root) init(root);

  function init(root: HTMLElement) {
    const canvas = root.querySelector<HTMLCanvasElement>('canvas')!;
    const stage = root.querySelector<HTMLElement>('.hm3d-stage')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const C = {
      lav: 0xcb6ce6, teal: 0x11676a, navy: 0x014a84, mint: 0xa0df85, yellow: 0xffde59,
      sky: 0x5e9fd3, orange: 0xff7f2f, brown: 0x944606, grey: 0x5b5856, water: 0x4fa6e8,
    };

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(36, 1, 0.1, 100);
    camera.position.set(10, 5.2, 12);
    const controls = new OrbitControls(camera, canvas);
    controls.target.set(0, 3.3, 0);
    controls.enableDamping = true;
    controls.enableZoom = false;
    controls.enablePan = false;
    controls.minPolarAngle = 0.35;
    controls.maxPolarAngle = 1.45;
    controls.autoRotate = !reduce;
    controls.autoRotateSpeed = 0.35;

    scene.add(new THREE.HemisphereLight(0xffffff, 0xd9c4e6, 1.6));
    const sun = new THREE.DirectionalLight(0xffffff, 1.6);
    sun.position.set(6, 12, 8);
    scene.add(sun);

    const mat = (color: number, extra: Partial<THREE.MeshStandardMaterialParameters> = {}) =>
      new THREE.MeshStandardMaterial({ color, roughness: 0.55, metalness: 0.05, ...extra });
    const glass = (color: number, opacity: number) =>
      new THREE.MeshPhysicalMaterial({ color, transparent: true, opacity, roughness: 0.1, metalness: 0, side: THREE.DoubleSide, depthWrite: false });
    const box = (w: number, h: number, d: number, m: THREE.Material, x = 0, y = 0, z = 0) => {
      const o = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), m); o.position.set(x, y, z); scene.add(o); return o;
    };

    // Ground and river
    const ground = new THREE.Mesh(new THREE.BoxGeometry(14, 0.2, 10), mat(0xeaf6e3));
    ground.position.y = -0.7; scene.add(ground);
    const riverTex = (() => {
      const c = document.createElement('canvas'); c.width = 64; c.height = 256;
      const g = c.getContext('2d')!; g.fillStyle = '#5e9fd3'; g.fillRect(0, 0, 64, 256);
      g.strokeStyle = 'rgba(255,255,255,0.55)'; g.lineWidth = 3;
      for (let y = 0; y < 256; y += 32) { g.beginPath(); g.moveTo(8, y); g.quadraticCurveTo(32, y + 12, 56, y); g.stroke(); }
      const t = new THREE.CanvasTexture(c); t.wrapS = t.wrapT = THREE.RepeatWrapping; t.repeat.set(1, 3); return t;
    })();
    const river = new THREE.Mesh(new THREE.PlaneGeometry(1.6, 9), new THREE.MeshStandardMaterial({ map: riverTex, roughness: 0.3 }));
    river.rotation.x = -Math.PI / 2; river.rotation.z = 0.45; river.position.set(3.2, -0.58, 2.6); scene.add(river);

    // ---------- Bottom: magnetic separation unit ----------
    const frameM = mat(C.lav);
    [[-1.7, -1.1], [-1.7, 1.1], [1.7, -1.1], [1.7, 1.1]].forEach(([x, z]) => box(0.3, 2.3, 0.3, frameM, x, 0.5, z));
    // open deck frame holding the middle unit, so the drum stays visible from above
    const deckM = mat(C.orange);
    box(3.7, 0.2, 0.3, deckM, 0, 1.75, 1.1); box(3.7, 0.2, 0.3, deckM, 0, 1.75, -1.1); box(0.3, 0.2, 2.5, deckM, 1.7, 1.75, 0); box(0.3, 0.2, 2.5, deckM, -1.7, 1.75, 0);
    box(3.4, 0.1, 0.16, deckM, 0, 1.78, 0); box(0.16, 0.1, 2.2, deckM, 0, 1.78, 0);

    const drum = new THREE.Group(); drum.position.set(0, 0.55, 0); scene.add(drum);
    const DR = 0.75;
    const drumShell = new THREE.Mesh(new THREE.CylinderGeometry(DR, DR, 2.6, 40, 1, true), glass(0xdff3ff, 0.32));
    drumShell.rotation.z = Math.PI / 2; drum.add(drumShell);
    const ribs = new THREE.Group(); drum.add(ribs);
    for (let i = 0; i < 6; i++) {
      const rib = new THREE.Mesh(new THREE.TorusGeometry(DR, 0.025, 6, 40), mat(0xffffff, { transparent: true, opacity: 0.7 }));
      rib.rotation.y = Math.PI / 2; rib.position.x = -1.2 + i * 0.48; ribs.add(rib);
    }
    const magnets = new THREE.Group(); drum.add(magnets);
    for (let i = 0; i < 8; i++) {
      const a = (i / 8) * Math.PI * 2;
      const m = new THREE.Mesh(new THREE.BoxGeometry(2.2, 0.16, 0.22), mat(i % 2 ? 0xd83030 : C.navy, { metalness: 0.4 }));
      m.position.set(0, Math.sin(a) * 0.5, Math.cos(a) * 0.5); m.rotation.x = -a; magnets.add(m);
    }
    const axle = new THREE.Mesh(new THREE.CylinderGeometry(0.06, 0.06, 3.3, 10), mat(C.grey));
    axle.rotation.z = Math.PI / 2; axle.position.copy(drum.position); scene.add(axle);

    // Scraper at the top back of the drum, bin behind it
    const SCRAPE = 2.55; // angle around the x axis where flocs are scraped (0 = front)
    const scraper = new THREE.Mesh(new THREE.BoxGeometry(2.5, 0.06, 0.7), mat(C.yellow));
    scraper.position.set(0, 0.55 + Math.sin(SCRAPE) * (DR + 0.28), Math.cos(SCRAPE) * (DR + 0.28));
    scraper.rotation.x = -SCRAPE + 0.5; scene.add(scraper);
    const bin = new THREE.Group(); bin.position.set(0, -0.35, -1.75); scene.add(bin);
    const binM = mat(C.teal);
    [[0, -0.3, 0, 2.6, 0.08, 1.0], [0, 0, 0.5, 2.6, 0.6, 0.08], [0, 0, -0.5, 2.6, 0.6, 0.08], [1.3, 0, 0, 0.08, 0.6, 1.0], [-1.3, 0, 0, 0.08, 0.6, 1.0]]
      .forEach(([x, y, z, w, h, d]) => { const p = new THREE.Mesh(new THREE.BoxGeometry(w, h, d), binM); p.position.set(x, y, z); bin.add(p); });

    // ---------- Middle: Pelton turbine, generator, battery ----------
    const wheel = new THREE.Group(); wheel.position.set(0, 2.55, 0); scene.add(wheel);
    wheel.add(new THREE.Mesh(new THREE.CylinderGeometry(0.55, 0.55, 0.12, 28), mat(C.orange)));
    for (let i = 0; i < 14; i++) {
      const a = (i / 14) * Math.PI * 2;
      const cup = new THREE.Mesh(new THREE.SphereGeometry(0.17, 12, 8, 0, Math.PI), mat(C.orange));
      cup.position.set(Math.cos(a) * 0.68, 0, Math.sin(a) * 0.68); cup.rotation.y = -a; wheel.add(cup);
    }
    const shaft = new THREE.Mesh(new THREE.CylinderGeometry(0.06, 0.06, 1.8, 10), mat(0x222222));
    shaft.position.set(0, 3.3, 0); scene.add(shaft);
    const gen = new THREE.Group(); gen.position.set(0, 3.55, 0); scene.add(gen);
    for (let i = 0; i < 7; i++) {
      const coil = new THREE.Mesh(new THREE.TorusGeometry(0.42, 0.06, 8, 24), mat(0xc77b30, { metalness: 0.6, roughness: 0.35 }));
      coil.rotation.x = Math.PI / 2; coil.position.y = -0.3 + i * 0.1; gen.add(coil);
    }
    const rotorMag = new THREE.Group(); gen.add(rotorMag);
    [0xd83030, C.navy].forEach((c, i) => { const m = new THREE.Mesh(new THREE.BoxGeometry(0.5, 0.55, 0.16), mat(c, { metalness: 0.4 })); m.position.x = i ? -0.13 : 0.13; rotorMag.add(m); });
    // battery
    const battery = new THREE.Group(); battery.position.set(-1.25, 2.35, 0.55); scene.add(battery);
    battery.add(new THREE.Mesh(new THREE.BoxGeometry(0.5, 0.9, 0.5), glass(0xffffff, 0.35)));
    const cap = new THREE.Mesh(new THREE.BoxGeometry(0.2, 0.1, 0.2), mat(C.grey)); cap.position.y = 0.5; battery.add(cap);
    const charge = new THREE.Mesh(new THREE.BoxGeometry(0.42, 0.82, 0.42), mat(C.mint, { emissive: 0x2c7a1c, emissiveIntensity: 0.4 }));
    charge.geometry.translate(0, 0.41, 0); charge.position.y = -0.41; battery.add(charge);
    // middle frame posts
    [[-1.7, -1.1], [-1.7, 1.1], [1.7, -1.1], [1.7, 1.1]].forEach(([x, z]) => box(0.12, 2.6, 0.12, mat(0x2b2b2b), x, 3.15, z));
    box(3.7, 0.2, 2.5, mat(C.orange), 0, 4.5, 0); // top deck holding the tank
    // ring tray under the wheel
    const tray = new THREE.Mesh(new THREE.TorusGeometry(1.0, 0.06, 8, 40), glass(0xffffff, 0.6));
    tray.rotation.x = Math.PI / 2; tray.position.y = 2.15; scene.add(tray);

    // ---------- Top: coagulation tank ----------
    const TANK_Y = 4.6, TANK_H = 2.6, TR = 1.05;
    const tank = new THREE.Mesh(new THREE.CylinderGeometry(TR * 1.12, TR, TANK_H, 40, 1, true), glass(0xffffff, 0.28));
    tank.position.y = TANK_Y + TANK_H / 2; scene.add(tank);
    const tankBase = new THREE.Mesh(new THREE.CylinderGeometry(TR, TR, 0.06, 40), mat(0xf4f4f4));
    tankBase.position.y = TANK_Y + 0.03; scene.add(tankBase);
    const waterBody = new THREE.Mesh(new THREE.CylinderGeometry(TR * 0.97, TR * 0.97, 1, 40), glass(C.water, 0.38));
    waterBody.geometry.translate(0, 0.5, 0); waterBody.position.y = TANK_Y + 0.06; scene.add(waterBody);
    const motor = box(0.45, 0.4, 0.45, mat(C.navy), 0, TANK_Y + TANK_H + 0.25, 0);
    const stirrer = new THREE.Group(); stirrer.position.y = TANK_Y + 0.3; scene.add(stirrer);
    const sShaft = new THREE.Mesh(new THREE.CylinderGeometry(0.04, 0.04, TANK_H - 0.1, 8), mat(0x333333)); sShaft.position.y = (TANK_H - 0.1) / 2; stirrer.add(sShaft);
    for (let i = 0; i < 3; i++) { const b = new THREE.Mesh(new THREE.BoxGeometry(0.75, 0.05, 0.16), mat(C.lav)); b.rotation.y = (i / 3) * Math.PI * 2; b.rotation.z = 0.25; stirrer.add(b); }

    // pipes
    const tube = (pts: number[][], r = 0.07, m: THREE.Material = glass(0xffffff, 0.45)) => {
      const curve = new THREE.CatmullRomCurve3(pts.map(([x, y, z]) => new THREE.Vector3(x, y, z)));
      scene.add(new THREE.Mesh(new THREE.TubeGeometry(curve, 60, r, 8, false), m)); return curve;
    };
    tube([[-1.9, 7.6, 0], [-1.6, 7.9, 0], [-0.8, 7.6, 0]], 0.08); // inlet

    // Water path: tank outlet -> nozzle -> wheel -> tray -> down pipe -> drum front -> river
    const path = new THREE.CatmullRomCurve3([
      [0.95, TANK_Y + 0.15, 0.3], [1.6, TANK_Y - 0.1, 0.6], [1.5, 3.2, 1.0], [0.75, 2.75, 0.45],
      [0.3, 2.25, 0.2], [-0.9, 2.1, 0.6], [-1.45, 1.6, 1.0], [-1.0, 1.1, 1.05],
      [-0.2, 0.75, 1.05], [0.7, 0.2, 1.05], [1.8, -0.35, 1.6], [2.6, -0.5, 3.0], [3.6, -0.55, 5.4],
    ].map(([x, y, z]) => new THREE.Vector3(x, y, z)));
    const DRUM_U = 0.6; // path position where water passes the drum face
    // visible pipe for the first part of the path
    tube([[0.95, TANK_Y + 0.15, 0.3], [1.6, TANK_Y - 0.1, 0.6], [1.5, 3.2, 1.0], [1.05, 2.85, 0.65]], 0.08);
    tube([[-0.9, 2.1, 0.6], [-1.45, 1.6, 1.0], [-1.1, 1.2, 1.05]], 0.08);
    const valve = box(0.22, 0.22, 0.22, mat(0xd83030), 1.35, TANK_Y + 0.02, 0.48);

    // wire generator -> battery -> motor
    const wire = new THREE.CatmullRomCurve3([[0.42, 3.55, 0], [-0.6, 3.4, 0.5], [-1.25, 2.85, 0.55], [-1.6, 4.0, 0.6], [-1.3, 7.0, 0.3], [-0.25, TANK_Y + TANK_H + 0.25, 0]].map(([x, y, z]) => new THREE.Vector3(x, y, z)));
    scene.add(new THREE.Mesh(new THREE.TubeGeometry(wire, 80, 0.025, 6, false), mat(0x222222)));

    // ---------- Particles ----------
    const rand = (a: number, b: number) => a + Math.random() * (b - a);
    const dummy = new THREE.Object3D();
    // tank contents: microplastics + nanoparticles
    const NMP = 46, NNP = 140;
    const mpColors = [0xff6fb5, C.yellow, C.mint, 0xffffff, 0x7fd6ff];
    const mpMesh = new THREE.InstancedMesh(new THREE.BoxGeometry(0.11, 0.03, 0.08), mat(0xffffff), NMP);
    const npMesh = new THREE.InstancedMesh(new THREE.SphereGeometry(0.028, 6, 5), mat(0x3a2412, { metalness: 0.5, roughness: 0.4 }), NNP);
    scene.add(mpMesh, npMesh);
    const mp = Array.from({ length: NMP }, (_, i) => { mpMesh.setColorAt(i, new THREE.Color(mpColors[i % mpColors.length])); return { r: rand(0.15, 0.85), a: rand(0, 6.28), y: rand(0.05, 0.95), spin: rand(0, 6.28) }; });
    const np = Array.from({ length: NNP }, (_, i) => ({ r: rand(0.1, 0.9), a: rand(0, 6.28), y: rand(0, 1), drop: rand(0, 1), host: i % NMP, off: new THREE.Vector3(rand(-1, 1), rand(-1, 1), rand(-1, 1)).normalize().multiplyScalar(0.07) }));
    mpMesh.instanceColor!.needsUpdate = true;

    // flowing water + flocs along the path
    const NW = 160, NF = 40;
    const dropMesh = new THREE.InstancedMesh(new THREE.SphereGeometry(0.045, 6, 5), new THREE.MeshStandardMaterial({ color: C.water, transparent: true, opacity: 0.85, roughness: 0.2 }), NW);
    const flocMesh = new THREE.InstancedMesh(new THREE.IcosahedronGeometry(0.075, 0), mat(0x4a2c14, { roughness: 0.8 }), NF);
    scene.add(dropMesh, flocMesh);
    const drops = Array.from({ length: NW }, () => ({ u: -1, s: rand(0.07, 0.1), j: new THREE.Vector3(rand(-1, 1), rand(-1, 1), rand(-1, 1)).multiplyScalar(0.06) }));
    type Floc = { state: 0 | 1 | 2 | 3 | 4; u: number; x: number; th: number; vy: number; p: THREE.Vector3 };
    const flocs: Floc[] = Array.from({ length: NF }, () => ({ state: 0, u: 0, x: 0, th: 0, vy: 0, p: new THREE.Vector3() }));
    // electrons on the wire
    const NE = 18;
    const eMesh = new THREE.InstancedMesh(new THREE.SphereGeometry(0.045, 8, 6), new THREE.MeshBasicMaterial({ color: 0xffd400 }), NE);
    scene.add(eMesh);
    const elec = Array.from({ length: NE }, (_, i) => i / NE);

    // ---------- Timeline ----------
    const STEP_T = [0, 3, 6, 11, 13, 16, 19];
    const LOOP = 30;
    let t = 0, playing = !reduce, captured = 0, batt = 0.4;
    let wheelSpeed = 0, drumAng = 0, stirAng = 0;

    const stepBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-step]')];
    const playBtn = root.querySelector<HTMLButtonElement>('[data-play]')!;
    const bText = root.querySelector('[data-battery]')!, bBar = root.querySelector<HTMLElement>('[data-battery-bar]')!;
    const rText = root.querySelector('[data-rpm]')!, fText = root.querySelector('[data-flocs]')!;
    const setPlay = (p: boolean) => { playing = p; playBtn.textContent = p ? '❚❚' : '▶'; playBtn.setAttribute('aria-label', p ? 'Pause' : 'Play'); };
    setPlay(playing);
    playBtn.addEventListener('click', () => setPlay(!playing));
    const resetFlow = () => { drops.forEach((d) => (d.u = -1)); flocs.forEach((f) => (f.state = 0)); captured = 0; };
    stepBtns.forEach((b, i) => b.addEventListener('click', () => {
      if (STEP_T[i] < t) resetFlow();
      t = STEP_T[i] + 0.01; if (i >= 3) prewarm(); setPlay(true);
    }));
    function prewarm() { // when jumping late in the loop, start the flow mid stream
      drops.forEach((d, i) => (d.u = (i / NW) * 0.98));
      if (t >= 16) flocs.forEach((f, i) => {
        if (i % 3 === 0) { f.state = 2; f.x = rand(-1.05, 1.05); f.th = rand(0.1, SCRAPE - 0.2) - drumAng; }
        else if (i % 3 === 1) { f.state = 1; f.u = rand(0, DRUM_U); }
      });
      if (t >= 19) captured = 4;
    }

    const smooth = (a: number, b: number, x: number) => { const k = Math.min(1, Math.max(0, (x - a) / (b - a))); return k * k * (3 - 2 * k); };

    // labels
    const anchors: Record<string, THREE.Vector3> = {
      tank: new THREE.Vector3(-1.3, TANK_Y + TANK_H + 0.2, 0), turbine: new THREE.Vector3(0.9, 3.0, -0.6), battery: new THREE.Vector3(-1.25, 2.95, 0.55),
      drum: new THREE.Vector3(1.75, 0.35, 0.9), bin: new THREE.Vector3(-1.2, -0.1, -2.4),
    };
    const tags = [...root.querySelectorAll<HTMLElement>('[data-anchor]')];

    let w = 0, h = 0;
    const resize = () => {
      w = stage.clientWidth; h = stage.clientHeight;
      renderer.setSize(w, h, false); camera.aspect = w / h;
      camera.position.setLength(w < 600 ? 19 : 16.5); camera.updateProjectionMatrix();
    };
    new ResizeObserver(resize).observe(stage); resize();

    let visible = false, last = performance.now(), raf = 0;
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; if (visible && !raf) { last = performance.now(); raf = requestAnimationFrame(frame); } }, { rootMargin: '100px' }).observe(stage);

    function frame(now: number) {
      raf = 0;
      const dt = Math.min(0.05, (now - last) / 1000); last = now;
      if (playing) { t += dt; if (t >= LOOP) { t = 0; resetFlow(); batt = 0.4; } }
      const sim = playing ? dt : 0;

      const fill = smooth(0, 3, t) * (1 - smooth(13, 27, t));
      const dose = smooth(3, 6, t);
      const stir = t >= 6 && t < 13 ? 1 : t >= 13 ? 0.35 : 0;
      const floc = smooth(7, 11, t);
      const draining = t >= 11 && fill > 0.04;
      const flow = draining ? smooth(11, 12.5, t) * Math.min(1, fill * 4) : 0;

      // tank water
      waterBody.scale.y = Math.max(0.001, fill * (TANK_H - 0.25));
      waterBody.visible = fill > 0.002;
      valve.rotation.y = draining ? Math.PI / 2 : 0;
      stirAng += sim * stir * 6; stirrer.rotation.y = stirAng;
      (motor.material as THREE.MeshStandardMaterial).emissive.setHex(stir > 0.5 ? 0x223a88 : 0x000000);

      // battery: stirring drains it, the turbine charges it
      batt += sim * (wheelSpeed * 0.0055 - stir * 0.012);
      batt = Math.min(1, Math.max(0.05, batt));
      charge.scale.y = batt;
      bText.textContent = Math.round(batt * 100) + '%'; bBar.style.width = batt * 100 + '%';

      // turbine
      const target = flow * 9;
      wheelSpeed += (target - wheelSpeed) * Math.min(1, sim * 1.5);
      wheel.rotation.y -= sim * wheelSpeed; rotorMag.rotation.y = wheel.rotation.y;
      rText.textContent = Math.round(wheelSpeed * 20) + ' rpm';

      // drum turns anticlockwise when water reaches it
      drumAng += sim * (0.25 + flow * 0.9);
      drum.rotation.x = drumAng;

      // tank particles
      const lvl = fill * (TANK_H - 0.25);
      for (let i = 0; i < NMP; i++) {
        const p = mp[i];
        p.a += sim * stir * (1.6 - p.r) * 2; p.spin += sim * 2;
        const visibleMp = fill > 0.02 && i / NMP < fill * 1.15;
        const y = TANK_Y + 0.12 + p.y * Math.max(0.05, lvl - 0.1);
        dummy.position.set(Math.cos(p.a) * p.r * TR, y, Math.sin(p.a) * p.r * TR);
        dummy.rotation.set(p.spin, p.spin * 0.7, 0);
        dummy.scale.setScalar(visibleMp ? 1 : 0.0001); dummy.updateMatrix(); mpMesh.setMatrixAt(i, dummy.matrix);
      }
      for (let i = 0; i < NNP; i++) {
        const n = np[i];
        n.a += sim * (stir * 2.4 + 0.1);
        let pos: THREE.Vector3;
        const fallen = dose > n.drop;
        const yTop = TANK_Y + TANK_H + 0.2;
        if (!fallen) { pos = new THREE.Vector3(Math.cos(n.a) * 0.3, yTop, Math.sin(n.a) * 0.3); }
        else {
          const k = Math.min(1, (dose - n.drop) * 4);
          const free = new THREE.Vector3(Math.cos(n.a) * n.r * TR, THREE.MathUtils.lerp(yTop, TANK_Y + 0.12 + n.y * Math.max(0.05, lvl - 0.1), k), Math.sin(n.a) * n.r * TR);
          const host = mp[n.host];
          const hy = TANK_Y + 0.12 + host.y * Math.max(0.05, lvl - 0.1);
          const hp = new THREE.Vector3(Math.cos(host.a) * host.r * TR, hy, Math.sin(host.a) * host.r * TR).add(n.off);
          pos = free.lerp(hp, floc);
        }
        const show = dose > 0 && fill > 0.02 && n.host / NMP < fill * 1.15;
        dummy.position.copy(pos); dummy.rotation.set(0, 0, 0); dummy.scale.setScalar(show ? 1 : 0.0001); dummy.updateMatrix(); npMesh.setMatrixAt(i, dummy.matrix);
      }
      mpMesh.instanceMatrix.needsUpdate = true; npMesh.instanceMatrix.needsUpdate = true;

      // flowing water
      for (let i = 0; i < NW; i++) {
        const d = drops[i];
        if (d.u < 0 && flow > 0.05 && Math.random() < flow * sim * 6) d.u = 0;
        if (d.u >= 0) { d.u += sim * d.s * (0.6 + flow * 0.6); if (d.u > 1) d.u = flow > 0.05 ? 0 : -1; }
        if (d.u >= 0) { dummy.position.copy(path.getPointAt(Math.min(1, d.u))).add(d.j); dummy.scale.setScalar(1); }
        else dummy.scale.setScalar(0.0001);
        dummy.rotation.set(0, 0, 0); dummy.updateMatrix(); dropMesh.setMatrixAt(i, dummy.matrix);
      }
      dropMesh.instanceMatrix.needsUpdate = true;
      (dropMesh.material as THREE.MeshStandardMaterial).color.setHex(t > 16 ? 0x8fd0ff : C.water);

      // flocs: ride the water, stick to the drum, get scraped into the bin
      for (let i = 0; i < NF; i++) {
        const f = flocs[i];
        if (f.state === 0 && flow > 0.1 && t > 12 && Math.random() < sim * 0.9) { f.state = 1; f.u = 0; }
        if (f.state === 1) {
          f.u += sim * 0.17;
          f.p.copy(path.getPointAt(Math.min(1, f.u)));
          if (f.u >= DRUM_U) { f.state = 2; f.x = rand(-1.05, 1.05); f.th = -drumAng + 0.05; }
        } else if (f.state === 2) {
          const ang = f.th + drumAng;
          f.p.set(f.x, 0.55 + Math.sin(ang) * (DR + 0.06), Math.cos(ang) * (DR + 0.06));
          if (ang >= SCRAPE) { f.state = 3; f.vy = 0; }
        } else if (f.state === 3) {
          f.vy -= sim * 6; f.p.y += f.vy * sim; f.p.z += (-1.75 - f.p.z) * Math.min(1, sim * 4);
          if (f.p.y <= -0.45 + (captured % 8) * 0.012) { f.state = 4; captured++; }
        }
        const show = f.state > 0;
        dummy.position.copy(f.p); dummy.rotation.set(i, i * 2, 0); dummy.scale.setScalar(show ? 1 : 0.0001); dummy.updateMatrix(); flocMesh.setMatrixAt(i, dummy.matrix);
      }
      flocMesh.instanceMatrix.needsUpdate = true;
      fText.textContent = String(captured);

      // electrons: generator -> battery while charging, battery -> motor while stirring
      for (let i = 0; i < NE; i++) {
        const charging = wheelSpeed > 0.5, powering = stir > 0.5;
        const on = charging || powering;
        if (on) elec[i] = (elec[i] + sim * (charging ? 0.35 : 0.25)) % 1;
        const span = charging ? [0, 0.35] : [0.35, 1];
        const u = span[0] + elec[i] * (span[1] - span[0]);
        dummy.position.copy(wire.getPointAt(u)); dummy.scale.setScalar(on ? 1 : 0.0001); dummy.updateMatrix(); eMesh.setMatrixAt(i, dummy.matrix);
      }
      eMesh.instanceMatrix.needsUpdate = true;

      riverTex.offset.y -= sim * (0.15 + flow * 0.4);

      // active step
      let s = 0; for (let i = 0; i < STEP_T.length; i++) if (t >= STEP_T[i]) s = i;
      stepBtns.forEach((b, i) => b.classList.toggle('is-on', i === s));

      controls.autoRotate = playing && !reduce;
      controls.update();
      renderer.render(scene, camera);

      // place labels
      for (const tag of tags) {
        const v = anchors[tag.dataset.anchor!].clone().project(camera);
        tag.style.transform = `translate(${(v.x * 0.5 + 0.5) * w}px, ${(-v.y * 0.5 + 0.5) * h}px) translate(-50%, -50%)`;
        tag.style.opacity = v.z < 1 ? '1' : '0';
      }

      if (visible) raf = requestAnimationFrame(frame);
    }
  }
</script>

