---
import { timeline, yearNotes, type Kind } from '../../data/timeline';

const kindLabel: Record<Kind, string> = {
  study: 'Studies',
  award: 'Award',
  competition: 'Competition',
  event: 'Event',
  now: 'Now',
};

// Academic journey only; everything else is shown in Highlights.
const items = timeline.filter((m) => m.academic);
// Group by year so each year gets one marker on the rail.
const years = [...new Set(items.map((m) => m.year))];

// Desktop rows: a semester card gets a row to itself, so its subjects can
// open into the empty column beside it; other cards pair up two per row.
function placed(y: number) {
  let row = 1;
  const used = new Set<number>();
  return items.filter((m) => m.year === y).map((m, i) => {
    const col = i % 2 ? 2 : 1;
    let r: number;
    if (m.courses) {
      if (used.size) { row++; used.clear(); }
      r = row; row++;
    } else {
      if (used.has(col)) { row++; used.clear(); }
      r = row; used.add(col);
    }
    return { m, i, r };
  });
}
---
<ol class="tl" id="tl">
  {years.map((y) => (
    <li class="tl-year">
      <span class="tl-ghost" aria-hidden="true">{y}</span>
      <h3 class="tl-year-label">{y}</h3>
      {yearNotes[y] && (
        <p class="tl-ms">{yearNotes[y].title}</p>
      )}
      <ol class="tl-items">
        {placed(y).map(({ m, i, r }) => {
          const solo = !!m.courses;
          return (<>
          <li style={`--r:${r}`} class:list={['tl-item', `tl-item--${m.kind}`, i % 2 ? 'tl-item--right' : 'tl-item--left', { 'tl-item--img': m.img, 'tl-item--solo': solo }]}>
            <span class="tl-dot" aria-hidden="true"></span>
            <div class="tl-body">
              {m.img && <img class="tl-img" src={m.img} alt="" loading="lazy" decoding="async" />}
              <p class="tl-meta">
                <span class="tl-kind">{kindLabel[m.kind]}</span>
                <span class="tl-date">{m.date}</span>
              </p>
              <h4 class="tl-title">
                {m.href ? <a href={m.href}>{m.title}</a> : m.title}
              </h4>
              {m.detail && <p class="tl-detail">{m.detail}</p>}
              {m.post && <a class="tl-post" href={m.post} target="_blank" rel="noopener">LinkedIn post ↗</a>}
              {m.gpa && (
                <dl class="tl-scores">
                  <div><dt>GPA</dt><dd>{m.gpa}</dd></div>
                  <div><dt>CGPA</dt><dd>{m.cgpa}</dd></div>
                  <div><dt>Standing</dt><dd class="tl-standing">{m.standing}</dd></div>
                </dl>
              )}
              {m.courses && (
                <details class="tl-courses">
                  <summary>{m.courses.length} subjects</summary>
                  <table>
                    <thead><tr><th>Code</th><th>Subject</th><th>Grade</th></tr></thead>
                    <tbody>
                      {m.courses.map((c) => (
                        <tr><td class="tl-code">{c.code}</td><td>{c.name}</td><td class="tl-grade">{c.grade}</td></tr>
                      ))}
                    </tbody>
                  </table>
                </details>
              )}
              {m.chips && (
                <ul class="tl-chips">
                  {m.chips.map((c) => <li class:list={{ 'tl-chip--dean': c.startsWith('Dean'), 'tl-chip--award': c.includes('Award') }}>{c}</li>)}
                </ul>
              )}
            </div>
          </li>
          {solo && (
            <li style={`--r:${r}`} class:list={['tl-panel', i % 2 ? 'tl-panel--left' : 'tl-panel--right']}>
              <p class="tl-panel-title">{m.title} subjects</p>
              <table>
                <thead><tr><th>Code</th><th>Subject</th><th>Grade</th></tr></thead>
                <tbody>
                  {m.courses!.map((c) => (
                    <tr><td class="tl-code">{c.code}</td><td>{c.name}</td><td class="tl-grade">{c.grade}</td></tr>
                  ))}
                </tbody>
              </table>
            </li>
          )}
          </>);
        })}
      </ol>
    </li>
  ))}
</ol>

<script>
  // Scroll effects: the rail fills as you scroll, each card slides in from
  // its side, dots light up once passed, and a large year floats behind.
  const tl = document.getElementById('tl');
  if (tl && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    tl.classList.add('tl--anim');
    const items = [...tl.querySelectorAll<HTMLElement>('.tl-item')];
    const years = [...tl.querySelectorAll<HTMLElement>('.tl-year')];
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
      }, { rootMargin: '0px 0px -12% 0px' });
      items.forEach((el) => io.observe(el));
    } else {
      items.forEach((el) => el.classList.add('is-in'));
    }
    let raf = 0;
    const update = () => {
      raf = 0;
      const r = tl.getBoundingClientRect();
      const line = innerHeight * 0.6;
      const p = Math.min(1, Math.max(0, (line - r.top) / r.height));
      tl.style.setProperty('--tl-p', p.toFixed(4));
      items.forEach((el) => {
        const dot = el.getBoundingClientRect().top + 30;
        el.classList.toggle('is-past', dot < line);
      });
      years.forEach((el) => {
        const yr = el.getBoundingClientRect();
        const t = (yr.top + yr.height / 2 - innerHeight / 2) / innerHeight;
        el.style.setProperty('--py', Math.max(-1, Math.min(1, t)).toFixed(3));
      });
    };
    addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(update); }, { passive: true });
    addEventListener('resize', update);
    update();
  }
</script>

<style>
  .tl, .tl-items { list-style: none; padding: 0; margin: 0; }
  .tl { margin-top: 2.5rem; position: relative; }
  .tl::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 0.6rem;
    bottom: 0;
    width: 2px;
    background: linear-gradient(var(--line), var(--accent) 60%, var(--trace));
  }
  .tl-year + .tl-year { margin-top: 2.5rem; }
  .tl-year-label {
    padding-left: 2.2rem;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 750;
    letter-spacing: -0.04em;
    color: var(--ink);
    line-height: 1;
  }
  .tl-ms {
    position: relative;
    z-index: 2;
    margin: 0.3rem 0 0 2.2rem;
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .tl-items { display: grid; gap: 1rem; margin-top: 1.2rem; }
  .tl-item {
    --k: var(--accent);
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.2rem;
    margin-left: 2.2rem;
    padding: 1.2rem 1.4rem;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: 14px;
  }
  .tl-item--award { --k: #B7791F; }
  .tl-item--competition { --k: #6D28D9; }
  .tl-item--event { --k: var(--steel); }
  .tl-item--now { --k: #15803D; }
  .tl-dot {
    position: absolute;
    left: calc(-2.2rem + 1px);
    top: 1.45rem;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--paper);
    border: 3px solid var(--k);
  }
  .tl-item--award .tl-dot { background: var(--trace); border-color: #B7791F; }
  .tl-body { min-width: 0; display: flow-root; }
  .tl-meta { display: flex; flex-wrap: wrap; gap: 0.3rem 0.8rem; align-items: baseline; font-size: 0.85rem; }
  .tl-kind { font-weight: 650; color: var(--k); }
  .tl-date { color: var(--muted); font-variant-numeric: tabular-nums; }
  .tl-title { font-family: var(--font-display); font-size: 1.15rem; font-weight: 650; line-height: 1.3; margin-top: 0.2rem; letter-spacing: -0.01em; }
  .tl-title a { text-decoration-color: var(--line); text-underline-offset: 3px; }
  .tl-title a:hover { color: var(--k); text-decoration-color: currentColor; }
  .tl-post { display: inline-block; margin-top: 0.5rem; font-size: 0.85rem; font-weight: 600; color: #0A66C2; text-decoration: none; }
  .tl-post:hover { text-decoration: underline; text-underline-offset: 3px; }
  .tl-detail { font-size: 0.95rem; color: var(--muted); margin-top: 0.3rem; }
  .tl-scores { display: flex; flex-wrap: wrap; gap: 0.5rem 1.6rem; margin: 0.8rem 0 0; }
  .tl-scores div { display: grid; }
  .tl-scores dt { font-size: 0.78rem; color: var(--muted); }
  .tl-scores dd { margin: 0; font-size: 1.5rem; font-weight: 700; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; color: var(--ink); }
  .tl-scores .tl-standing { font-size: 1rem; font-weight: 650; color: #15803D; padding-top: 0.45rem; }
  .tl-courses { margin-top: 0.8rem; font-size: 0.9rem; }
  .tl-courses summary { cursor: pointer; font-weight: 600; color: var(--accent); width: fit-content; }
  .tl-courses summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 4px; }
  .tl-panel { display: none; }
  .tl-courses table, .tl-panel table { width: 100%; border-collapse: collapse; margin-top: 0.6rem; }
  .tl-panel th, .tl-courses th { text-align: left; font-size: 0.75rem; font-weight: 600; color: var(--muted); padding: 0.3rem 0.5rem 0.3rem 0; border-bottom: 1px solid var(--line); }
  .tl-panel td, .tl-courses td { padding: 0.4rem 0.5rem 0.4rem 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  .tl-code { color: var(--muted); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .tl-grade { font-weight: 700; text-align: center; width: 3.5rem; }
  .tl-chips { list-style: none; padding: 0; margin-top: 0.9rem; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .tl-chips li { font-size: 0.82rem; font-weight: 550; padding: 0.25rem 0.7rem; border-radius: 999px; background: color-mix(in srgb, var(--k) 10%, transparent); color: var(--ink); }
  .tl-img { float: right; width: 190px; height: auto; max-height: 260px; object-fit: cover; border-radius: 10px; margin: 0.2rem 0 0.7rem 1.1rem; }
  /* Dean's List uses the same green as the degree semesters' standing. */
  .tl-chips li.tl-chip--dean { background: #DCF2E3; color: #15803D; font-weight: 650; }
  .tl-chips li.tl-chip--award { background: #FBEFD5; color: #8A5A0B; font-weight: 650; }
  @media (max-width: 600px) {
    .tl-ms { margin-left: 1.8rem; }
    .tl-item { margin-left: 1.8rem; padding: 1rem; }
    .tl-dot { left: calc(-1.8rem + 1px); }
    .tl-year-label { padding-left: 1.8rem; }
    .tl-img { float: none; display: block; width: 100%; max-height: none; height: auto; aspect-ratio: 4 / 3; margin: 0 0 0.9rem; }
  }

  /* Desktop: rail down the middle, cards alternate left and right. */
  @media (min-width: 900px) {
    .tl::before { left: calc(50% - 1px); }
    .tl-year + .tl-year { margin-top: 1.5rem; }
    .tl-year-label {
      padding-left: 0;
      text-align: center;
      font-size: 2rem;
      position: relative;
      background: var(--paper);
      width: fit-content;
      margin-inline: auto;
      padding: 0.3rem 0.8rem;
    }
    .tl-ms { margin: 0.2rem auto 0; width: fit-content; max-width: 100%; text-align: center; background: var(--paper); padding: 0.2rem 0.8rem; }
    .tl-items {
      margin-top: 0.8rem;
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: 4.4rem;
      row-gap: 1rem;
      align-items: start;
    }
    .tl-item { margin-left: 0; padding: 1rem 1.2rem; }
    .tl-item--left { grid-column: 1; }
    .tl-item--right { grid-column: 2; }
    .tl-item--left .tl-dot { left: auto; right: calc(-2.2rem - 8px); }
    .tl-item--right .tl-dot { left: calc(-2.2rem - 6px); }
    .tl-img { float: right; width: 190px; height: auto; max-height: 260px; object-fit: cover; margin: 0.2rem 0 0.7rem 1.1rem; aspect-ratio: auto; }
    .tl-title { font-size: 1.05rem; }
    .tl-scores dd { font-size: 1.3rem; }
    /* Lone left card: open subjects fill the empty right column instead of growing the card down. */
    .tl-item--solo .tl-courses table { display: none; }
    .tl-item, .tl-panel { grid-row: var(--r); }
    .tl-item--solo:has(.tl-courses[open]) + .tl-panel {
      display: block;
      padding: 1rem 1.2rem;
      background: var(--paper-raised);
      border: 1px solid var(--line);
      border-radius: 14px;
      font-size: 0.9rem;
      animation: tl-panel-in 0.35s ease both;
    }
    .tl-panel--right { grid-column: 2; }
    .tl-panel--left { grid-column: 1; animation-name: tl-panel-in-r !important; }
    .tl-panel-title { font-weight: 650; font-size: 0.95rem; color: var(--ink); margin-bottom: 0.3rem; }
  }
  @keyframes tl-panel-in { from { opacity: 0; transform: translateX(-12px); } }
  @keyframes tl-panel-in-r { from { opacity: 0; transform: translateX(12px); } }
  @media (min-width: 900px) and (prefers-reduced-motion: reduce) {
    .tl-item--solo:has(.tl-courses[open]) + .tl-panel { animation: none !important; }
  }

  /* ---------- Scroll effects ---------- */
  .tl-year { position: relative; isolation: isolate; z-index: 1; }
  .tl-ghost {
    position: absolute;
    right: 0;
    top: 0;
    z-index: -1;
    font-size: clamp(7rem, 18vw, 15rem);
    font-weight: 800;
    letter-spacing: -0.06em;
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(var(--accent-rgb), 0.12);
    pointer-events: none;
    user-select: none;
    transform: translateY(calc(var(--py, 0) * -90px));
  }
  .tl::after {
    content: '';
    position: absolute;
    left: 7px;
    top: 0.6rem;
    bottom: 0;
    width: 2px;
    background: linear-gradient(var(--accent), var(--trace));
    transform: scaleY(var(--tl-p, 1));
    transform-origin: top;
    box-shadow: 0 0 10px rgba(var(--accent-rgb), 0.45);
  }
  .tl--anim .tl-item {
    transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .tl--anim .tl-item:not(.is-in) { opacity: 0; transform: translateX(-28px); }
  .tl--anim .tl-item--right:not(.is-in) { transform: translateX(28px); }
  .tl-dot { transition: background 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease; z-index: 1; }
  .tl--anim .tl-item.is-past .tl-dot {
    background: var(--k);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--k) 22%, transparent);
    transform: scale(1.1);
  }
  @media (min-width: 900px) {
    .tl::after { left: calc(50% - 1px); }
    .tl-ghost { right: auto; left: 50%; translate: -50% 0; top: -1.5rem; }
  }
</style>
