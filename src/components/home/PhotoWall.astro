---
import { wallPhotos } from '../../data/wall';

// Deal the photos round-robin into rows so each row shows a different set.
const ROWS = 4;
const rows = Array.from({ length: ROWS }, (_, r) => wallPhotos.filter((_, i) => i % ROWS === r));
const speeds = [90, 110, 80, 100];
---
<div class="wall" aria-hidden="true">
  {rows.map((photos, r) => (
    <div class:list={['wall-row', { 'wall-row--right': r % 2 === 1 }]} style={`--dur:${speeds[r]}s`}>
      <div class="wall-track">
        {[...photos, ...photos].map((src) => (
          <img src={src} alt="" decoding="async" />
        ))}
      </div>
    </div>
  ))}
</div>

<script>
  // Pause the wall when the hero is off screen.
  const wall = document.querySelector<HTMLElement>('.wall');
  if (wall && 'IntersectionObserver' in window) {
    new IntersectionObserver(([e]) => wall.classList.toggle('is-paused', !e.isIntersecting)).observe(wall);
  }
</script>

<style>
  .wall {
    --gap: 10px;
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-rows: repeat(4, 1fr);
    gap: var(--gap);
    padding-block: var(--gap);
    overflow: hidden;
    background: var(--ink);
  }
  .wall-row { overflow: hidden; min-height: 0; }
  .wall-track {
    display: flex;
    gap: var(--gap);
    height: 100%;
    width: max-content;
    animation: wall-left var(--dur) linear infinite;
  }
  .wall-row--right .wall-track { animation-name: wall-right; }
  .wall.is-paused .wall-track { animation-play-state: paused; }
  .wall img {
    height: 100%;
    width: auto;
    max-width: none;
    border-radius: 8px;
    object-fit: cover;
  }
  @keyframes wall-left {
    from { transform: translateX(0); }
    to { transform: translateX(calc(-50% - var(--gap) / 2)); }
  }
  @keyframes wall-right {
    from { transform: translateX(calc(-50% - var(--gap) / 2)); }
    to { transform: translateX(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .wall-track { animation: none; }
  }
</style>
