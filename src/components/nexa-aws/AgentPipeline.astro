---
const agents = [
  { t: 'Profile', d: 'Profile & org chart' },
  { t: 'Setup', d: 'Provisions IT access' },
  { t: 'Knowledge', d: 'RAG Q&A + citations' },
  { t: 'Communication', d: 'Emails · Teams · calls' },
  { t: 'Daily Task', d: 'Tasks & incidents' },
];
const services = ['DynamoDB', 'Amazon S3', 'Bedrock KB', 'Amazon SES', 'EventBridge'];
---
<div class="agentflow" data-reveal>
  <div class="af-row af-entry">
    <div class="af-node af-dashboard">
      <span class="af-num">1</span>
      <h3>Web Dashboard</h3>
      <p class="muted">Profile · org chart · live progress · AI chat · FAQ</p>
    </div>
    <div class="af-arrow" aria-hidden="true">↓ HTTPS</div>
    <div class="af-node af-gateway">
      <span class="af-num">2</span>
      <h3>Amazon API Gateway</h3>
      <p class="muted">Auth (OAuth/JWT) · routing · rate limiting · TLS 1.3</p>
    </div>
    <div class="af-arrow" aria-hidden="true">↓</div>
    <div class="af-node af-orchestrator">
      <span class="af-num">3</span>
      <h3>Orchestrator Agent</h3>
      <p class="muted">Amazon Bedrock Multi-Agent Collaboration (supervisor pattern) — routes, aggregates, tracks state</p>
    </div>
  </div>

  <div class="af-agents">
    {agents.map((a) => (
      <div class="af-agent">
        <h4>{a.t}</h4>
        <p class="muted">{a.d}</p>
      </div>
    ))}
  </div>

  <div class="af-arrow" aria-hidden="true">↓</div>

  <div class="af-services">
    <span class="af-num">4</span>
    <h3>Data &amp; Integration Services</h3>
    <ul>
      {services.map((s) => <li>{s}</li>)}
    </ul>
  </div>

  <p class="af-footnote muted">
    ↩ Step 6 — agent responses are aggregated by the orchestrator and streamed
    back to the dashboard in real time over WebSocket.
  </p>
</div>

<style>
  .agentflow { background: var(--paper-raised); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.75rem; }
  .af-row.af-entry { display: flex; flex-direction: column; align-items: center; gap: 0.4rem; }
  .af-node {
    width: 100%;
    max-width: 480px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) - 6px);
    padding: 1rem 1.2rem;
    text-align: center;
    position: relative;
  }
  .af-orchestrator { background: #14181F; border-color: #14181F; }
  .af-orchestrator h3 { color: #F6F8FB; }
  .af-orchestrator p { color: #9DB2D6; }
  .af-num {
    position: absolute;
    top: -10px;
    left: -10px;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .af-node h3 { font-size: 0.98rem; }
  .af-node p { font-size: 0.82rem; margin-top: 0.25rem; }
  .af-arrow { text-align: center; color: var(--steel); font-size: 0.85rem; margin: 0.35rem 0; }
  .af-agents {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 0.75rem;
    margin-top: 0.6rem;
  }
  .af-agent {
    background: var(--accent-soft);
    border-radius: calc(var(--radius) - 8px);
    padding: 0.85rem 1rem;
    text-align: center;
  }
  .af-agent h4 { font-size: 0.88rem; color: var(--accent); }
  .af-agent p { font-size: 0.76rem; margin-top: 0.2rem; }
  .af-services {
    position: relative;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: calc(var(--radius) - 6px);
    padding: 1rem 1.2rem;
    text-align: center;
  }
  .af-services h3 { font-size: 0.98rem; }
  .af-services ul { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; margin-top: 0.6rem; }
  .af-services li { font-size: 0.78rem; padding: 0.25rem 0.7rem; border-radius: 999px; border: 1px solid var(--line); }
  .af-footnote { text-align: center; font-size: 0.82rem; margin-top: 1rem; }
</style>
