---
interface Props {
  title: string;
  description: string;
  poster: string;
  src: string;
}
const { title, description, poster, src } = Astro.props;
---
<figure class="vcard" data-reveal>
  <button class="vcard-frame" type="button" data-src={src} aria-label={`Play demo: ${title}`}>
    <img src={poster} alt={`${title} — preview frame`} loading="lazy" width="1280" height="620" />
    <span class="vcard-play" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none"><path d="M8 5v14l11-7L8 5z" fill="currentColor" /></svg>
    </span>
  </button>
  <figcaption>
    <h3>{title}</h3>
    <p class="muted">{description}</p>
  </figcaption>
</figure>

<style>
  .vcard {
    margin: 0;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .vcard-frame {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: none;
    padding: 0;
    cursor: pointer;
    background: #0B0F1A;
  }
  .vcard-frame img,
  .vcard-frame video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .vcard-play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .vcard-play svg {
    width: 56px;
    height: 56px;
    padding: 14px;
    box-sizing: content-box;
    color: #FFFFFF;
    background: rgba(var(--accent-rgb), 0.85);
    border-radius: 50%;
    transition: transform 0.2s ease, background 0.2s ease;
  }
  .vcard-frame:hover .vcard-play svg { transform: scale(1.08); background: var(--accent); }
  .vcard-frame.is-playing .vcard-play { display: none; }
  .vcard figcaption { padding: 1rem 1.1rem 1.2rem; }
  .vcard h3 { font-size: 1.05rem; }
  .vcard p { font-size: 0.88rem; margin-top: 0.3rem; }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.vcard-frame').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (btn.classList.contains('is-playing')) return;
      const src = btn.dataset.src;
      if (!src) return;
      const video = document.createElement('video');
      video.src = src;
      video.controls = true;
      video.autoplay = true;
      video.playsInline = true;
      btn.querySelector('img')?.remove();
      btn.appendChild(video);
      btn.classList.add('is-playing');
    });
  });
</script>
