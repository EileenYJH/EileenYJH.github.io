---
// The photo from the home-page highlight card, shown on the project page too.
interface Props { src: string; alt: string; caption: string }
const { src, alt, caption } = Astro.props;
---
<section class="section wrap event-photo" data-reveal>
  <figure>
    <img src={src} alt={alt} loading="lazy" decoding="async" />
    <figcaption>{caption}</figcaption>
  </figure>
</section>

<style>
  .event-photo { padding-block: 0; margin-top: calc(var(--space-section) * -0.7); }
  .event-photo figure {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    margin: 0;
    padding: 1rem;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: 18px;
    width: fit-content;
    max-width: 100%;
  }
  .event-photo img { width: auto; max-width: min(420px, 100%); max-height: 340px; height: auto; border-radius: 12px; display: block; }
  .event-photo figcaption { width: 26ch; max-width: 100%; flex: none; padding-right: 0.6rem; color: var(--muted); font-size: 0.98rem; line-height: 1.55; }
  @media (max-width: 700px) {
    .event-photo figure { flex-direction: column; align-items: flex-start; width: 100%; }
    .event-photo img { max-width: 100%; max-height: none; width: 100%; }
    .event-photo figcaption { width: auto; }
  }
</style>
