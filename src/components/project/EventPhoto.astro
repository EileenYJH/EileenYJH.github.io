---
// The highlight card's photo, shown large as the first image on its project page.
interface Props { src: string; alt: string; caption: string; post?: string }
const { src, alt, caption, post } = Astro.props;
---
<section class="wrap event-photo" data-reveal>
  <figure>
    <img src={src} alt={alt} decoding="async" fetchpriority="high" />
    <figcaption>{caption}{post && <> <a class="event-post" href={post} target="_blank" rel="noopener">Read my LinkedIn post ↗</a></>}</figcaption>
  </figure>
</section>

<style>
  .event-photo { margin-top: calc(var(--space-section) * -0.55); margin-bottom: calc(var(--space-section) * -0.35); }
  .event-photo figure { margin: 0; }
  .event-photo img {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: min(78vh, 760px);
    height: auto;
    border-radius: 18px;
    box-shadow: 0 30px 60px -35px rgba(21, 26, 46, 0.45);
  }
  .event-photo figcaption { margin-top: 0.8rem; color: var(--muted); font-size: 0.95rem; max-width: none; }
  .event-post { font-weight: 600; color: #0A66C2; text-decoration: none; white-space: nowrap; }
  .event-post:hover { text-decoration: underline; text-underline-offset: 3px; }
</style>
